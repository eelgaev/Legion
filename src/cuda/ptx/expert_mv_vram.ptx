    // ---- gate ----
    shr.u32         %r61, %r41, %r60;       // s0
    shr.u32         %r62, %r42, %r60;       // s2
    shr.u32         %r63, %r43, %r60;       // s4
    // aux0: lo (s0 & 0x3f3f), hi ((s4 & 0x0f0f) | ((s0 & 0xc0c0) >> 2))
