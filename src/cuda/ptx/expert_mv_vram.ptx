    mov.b32         {lo, hi}, %xa3;
    cvt.f32.f16     d81, lo;                // d8[1]
    dp4a.s32.s32    dot2a, 16843009, %xa1, 0;
    dp4a.s32.s32    dot2a, 16843009, %xa2, dot2a;   // dot2, i = 0
