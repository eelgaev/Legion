    mov.f32         %f29, %fag2;
    mov.f32         %f30, %fau2;
    @!%p11 bra      SILUU3_2;
    min.ftz.f32     %f29, %f29, %f27;
    max.ftz.f32     %f30, %f30, %f28;
    min.ftz.f32     %f30, %f30, %f27;
SILUU3_2:
    mul.rn.ftz.f32  %f31, %f29, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f31, %f31;
    add.rn.ftz.f32  %f32, %f31, 0f3F800000;
    div.approx.ftz.f32 %f33, %f29, %f32;
    mul.rn.ftz.f32  %f34, %f30, %f33;
    st.global.f32   [%rd35], %f34;
    bra.uni         NEXT;

U4:
    div.u32         %rut0, %ruq0, %r2;
    rem.u32         %ruj0, %ruq0, %r2;
    selp.b32        %rux0, 0, %ruj0, %p4;
    mad.lo.s32      %rux0, %rut0, %r27, %rux0;
    cvt.u64.u32     %ruy0, %rux0;
    mad.lo.s64      %ruy0, %ruy0, %rd15, %rd14;     // y_0
    div.u32         %rut1, %ruq1, %r2;
    rem.u32         %ruj1, %ruq1, %r2;
    selp.b32        %rux1, 0, %ruj1, %p4;
    mad.lo.s32      %rux1, %rut1, %r27, %rux1;
    cvt.u64.u32     %ruy1, %rux1;
    mad.lo.s64      %ruy1, %ruy1, %rd15, %rd14;     // y_1
    div.u32         %rut2, %ruq2, %r2;
    rem.u32         %ruj2, %ruq2, %r2;
    selp.b32        %rux2, 0, %ruj2, %p4;
    mad.lo.s32      %rux2, %rut2, %r27, %rux2;
    cvt.u64.u32     %ruy2, %rux2;
    mad.lo.s64      %ruy2, %ruy2, %rd15, %rd14;     // y_2
    div.u32         %rut3, %ruq3, %r2;
    rem.u32         %ruj3, %ruq3, %r2;
    selp.b32        %rux3, 0, %ruj3, %p4;
    mad.lo.s32      %rux3, %rut3, %r27, %rux3;
    cvt.u64.u32     %ruy3, %rux3;
    mad.lo.s64      %ruy3, %ruy3, %rd15, %rd14;     // y_3
    mov.f32         %fag0, 0f00000000;
    mov.f32         %fau0, 0f00000000;
    mov.f32         %fag1, 0f00000000;
    mov.f32         %fau1, 0f00000000;
    mov.f32         %fag2, 0f00000000;
    mov.f32         %fau2, 0f00000000;
    mov.f32         %fag3, 0f00000000;
    mov.f32         %fau3, 0f00000000;
    selp.b32        %r30, %r16, %r29, %p3;  // c: rows past the end take no units
    setp.ge.s32     %p5, %r30, %r29;
    @%p5 bra        REDUCEU4;
LOOPU4:
    // Unit c: block kbx = c / 16, h = c % 16.
    shr.u32         %r31, %r30, 4;          // kbx
    and.b32         %r32, %r30, 15;         // h
    shr.u32         %r33, %r32, 2;          // h / 4
    shl.b32         %r34, %r33, 1;          // bq8_offset
    and.b32         %r35, %r32, 3;          // h % 4
    mul.wide.u32    %rd18, %r31, 144;
    // nibble ints: 16 + 16 * bq8_offset + 4 * (h % 4) = 16 + 32 * (h / 4) + 4 * (h % 4)
    shl.b32         %r36, %r33, 5;
    shl.b32         %r37, %r35, 2;
    add.s32         %r38, %r36, %r37;
    add.s32         %r38, %r38, 16;
    cvt.u64.u32     %rd19, %r38;
    add.s64         %rd20, %rd12, %rd18;    // gate block
    add.s64         %rd21, %rd13, %rd18;    // up block
    add.s64         %rd22, %rd20, %rd19;
    add.s64         %rd23, %rd21, %rd19;
    // Activations: blocks kbx * 8 + bq8_offset and +1, ints (h % 4) and (h % 4) + 4 of each.
    shl.b32         %r39, %r31, 3;
    add.s32         %r39, %r39, %r34;
    mul.wide.u32    %rd24, %r39, 36;
    cvt.u64.u32     %rd25, %r37;
    add.s64         %rd26, %rd24, %rd25;

    // Every load of the unit first.
    ld.global.nc.v4.u32 {%r40, %r41, %r42, %r43}, [%rd20];   // gate dm, scales
    ld.global.nc.u32    %r44, [%rd22];                       // gate v[0]
    ld.global.nc.u32    %r45, [%rd22+16];                    // gate v[1]
    ld.global.nc.v4.u32 {%r46, %r47, %r48, %r49}, [%rd21];   // up dm, scales
    ld.global.nc.u32    %r50, [%rd23];
    ld.global.nc.u32    %r51, [%rd23+16];
    add.s64         %rdb0, %ruy0, %rd24;     // user 0: block bq8_offset
    add.s64         %rdi0, %ruy0, %rd26;
    ld.global.nc.u32    %xa0, [%rdb0];                     // ds of block bq8_offset
    ld.global.nc.u32    %xa1, [%rdi0+4];                   // u[0]
    ld.global.nc.u32    %xa2, [%rdi0+20];                  // u[1]
    ld.global.nc.u32    %xa3, [%rdb0+36];                  // ds of block bq8_offset + 1
    ld.global.nc.u32    %xa4, [%rdi0+40];                  // u[2]
    ld.global.nc.u32    %xa5, [%rdi0+56];                  // u[3]
    add.s64         %rdb1, %ruy1, %rd24;     // user 1: block bq8_offset
    add.s64         %rdi1, %ruy1, %rd26;
    ld.global.nc.u32    %xa6, [%rdb1];                     // ds of block bq8_offset
    ld.global.nc.u32    %xa7, [%rdi1+4];                   // u[0]
    ld.global.nc.u32    %xa8, [%rdi1+20];                  // u[1]
    ld.global.nc.u32    %xa9, [%rdb1+36];                  // ds of block bq8_offset + 1
    ld.global.nc.u32    %xa10, [%rdi1+40];                  // u[2]
    ld.global.nc.u32    %xa11, [%rdi1+56];                  // u[3]
    add.s64         %rdb2, %ruy2, %rd24;     // user 2: block bq8_offset
    add.s64         %rdi2, %ruy2, %rd26;
    ld.global.nc.u32    %xa12, [%rdb2];                     // ds of block bq8_offset
    ld.global.nc.u32    %xa13, [%rdi2+4];                   // u[0]
    ld.global.nc.u32    %xa14, [%rdi2+20];                  // u[1]
    ld.global.nc.u32    %xa15, [%rdb2+36];                  // ds of block bq8_offset + 1
    ld.global.nc.u32    %xa16, [%rdi2+40];                  // u[2]
    ld.global.nc.u32    %xa17, [%rdi2+56];                  // u[3]
    add.s64         %rdb3, %ruy3, %rd24;     // user 3: block bq8_offset
    add.s64         %rdi3, %ruy3, %rd26;
    ld.global.nc.u32    %xa18, [%rdb3];                     // ds of block bq8_offset
    ld.global.nc.u32    %xa19, [%rdi3+4];                   // u[0]
    ld.global.nc.u32    %xa20, [%rdi3+20];                  // u[1]
