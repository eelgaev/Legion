    // ---- up ----
    shr.u32         %r86, %r47, %r60;
    shr.u32         %r87, %r48, %r60;
    shr.u32         %r88, %r49, %r60;
    and.b32         %r89, %r86, 16191;
    and.b32         %r90, %r88, 3855;
    and.b32         %r91, %r86, 49344;
    shr.u32         %r91, %r91, 2;
    or.b32          %r90, %r90, %r91;
    selp.b32        %r92, %r90, %r89, %p6;
    and.b32         %r93, %r87, 16191;
    shr.u32         %r94, %r88, 4;
    and.b32         %r94, %r94, 3855;
    and.b32         %r95, %r87, 49344;
    shr.u32         %r95, %r95, 2;
    or.b32          %r94, %r94, %r95;
    selp.b32        %r96, %r94, %r93, %p6;
    and.b32         %r97, %r92, 63;
    bfe.u32         %r98, %r92, 8, 8;
    and.b32         %r99, %r96, 63;
    bfe.u32         %r100, %r96, 8, 8;
    and.b32         %r101, %r50, 252645135;
    and.b32         %r102, %r51, 252645135;
    shr.u32         %r106, %r50, 4;
    and.b32         %r106, %r106, 252645135;
    shr.u32         %r107, %r51, 4;
    and.b32         %r107, %r107, 252645135;
    {
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %r46;
