//
// Decode MoE expert matvec for experts in VRAM, hand-written PTX for sm_70 (#703, #710). Loaded at
// run time by src/ptx.rs (cuModuleLoadDataEx) and launched by src/model/core/expert_mv/ptx.rs on
// the op's stream, after expert_mv.cu's quantize_x (the Q8_1 activations, block_q8_1 layout) and
// the tile kernel (which then leaves the VRAM pairs alone: vram_kernel 2). Generated by
// gen_expert_mv_vram.py: edit that and regenerate.
//
// Each (token, slot) pair whose expert id is below vram_below (an expert-cache slot) is read in
// place: no shared-memory tile, no barrier, each lane's weight and activation loads issued before
// its dot products, the expert's header read as one 16-byte load. As in expert_mv_tile, of the
// pairs that chose the same expert only the first one's CTAs run, and they compute every pair of
// that expert (its users) against one read of the rows: up to 4 users at a time, each weight unit
// loaded and decoded once for all of them (a code path per user count), more in further rounds.
// A step of one token (n_tok 1) has one user per expert and skips the search.
//
// Bits: every (row, pair) sum is expert_mv_tile's. A row takes L lanes (L = lanes_per_row(units),
// a power of 2; P_LSHIFT = log2 L), lane `sub` sums units sub, sub + L, ... in that order from
// 0.0, then the lanes meet in the butterfly of sum_lanes (offsets L/2 .. 1). A unit is ggml's
// vec_dot_q4_K_q8_1 / vec_dot_q5_1_q8_1 (vecdotq.cuh, MIT) with the float operations ptxas makes
// of nvcc's code for them (fast math, FTZ), pinned here with .rn so ptxas cannot fuse them
// differently:
//   Q4_K: sumf_d = fma(d8[i], float(dot1 * sc[i]), sumf_d), the same for sumf_m with m[i] (from
//         0.0), then fma(sumf_d, dm.x, -(sumf_m * dm.y)).
//   Q5_1: fma(d5d8, float(sumi), m5s8 / 2) with (d5d8, m5s8) = half2(dm) * half2(ds) in f16x2.
//   SwiGLU: u * (g / (1 + ex2(g * -log2(e)))), after the clamp when limit > 0.
// Each user keeps its own sums, so how many users share a pass does not change them.
//
// Parameters: one struct, src/model/core/expert_mv/ptx.rs `PtxParams` (its tests check the
// offsets used here):
//    0 w        u64  expert 0 of the (gate) matrix       64 dst      u64  [n_tok][n_used][rows] f32
//    8 w2       u64  expert 0 of up (SwiGLU)             72 dst_nb1  i64
//   16 w_nb1    i64  bytes per row                       80 dst_nb2  i64
//   24 w_nb2    i64  bytes per expert                    88 rows     i32
//   32 xq       u64  Q8_1 activations                    92 n_used   i32
//   40 xq_col   i64  bytes per activation column         96 n_x      i32  1 or n_used
//   48 ids      u64  [n_tok][n_used] i32                100 vram_below i32
//   56 ids_nb1  i64                                     104 n_w      i32
//  108 part     i32  0, 1, 3: VRAM pairs taken; 2, 4: none
//  112 units    i32  vec_dot units per row              116 lshift   i32  log2 of the lanes per row
//  120 limit    f32  SwiGLU clamp (0: none)             124 n_tok    i32  tokens of the step
// Grid: x row blocks of 4 warps x (32 >> lshift) rows, y pairs; 128 threads.
//
.version 7.0
.target sm_70
.address_size 64

// gate/up Q4_K (144-byte blocks of 256: half2 dm, 12 bytes of 6-bit scales and mins, 128 of
// nibbles), SwiGLU of the two sums. A unit is 8 nibble bytes (two ints 16 bytes apart) of one
// block: unit c is block c / 16, iqs 2 * (c % 16). L is 32 here, so c % 16 is the same for all
// of a lane's units.
// One user.
.visible .entry legion_ptx_q4k_glu(
    .param .align 8 .b8 P[128]
)
.maxntid 128, 1, 1
{
    .reg .pred  %p<12>;
    .reg .b32   %r<120>;
    .reg .b64   %rd<40>;
    .reg .f32   %f<48>;
    .reg .b32   %rnt, %rnp, %rskip, %rnu, %rtot, %rbase;
    .reg .b32   %rsq, %rsid, %rst, %rsj, %rsm, %rsl, %rslo, %rse, %rsb;
    .reg .b64   %rds1, %rds2;
    .reg .b32   %ruq<4>, %rut<4>, %ruj<4>, %rux<4>;
    .reg .b64   %ruy<4>, %rdb<4>, %rdi<4>;
    .reg .b32   %xa<24>;
    .reg .f32   %fag<4>, %fau<4>;

    // The pair q and its expert e.
    mov.u32         %r1, %ctaid.y;
    ld.param.u32    %r2, [P+92];            // n_used
    div.u32         %r3, %r1, %r2;          // t
    rem.u32         %r4, %r1, %r2;          // j
    ld.param.u64    %rd1, [P+48];           // ids
    ld.param.u64    %rd2, [P+56];           // ids_nb1
    cvt.u64.u32     %rd3, %r3;
    mul.lo.s64      %rd4, %rd3, %rd2;
    add.s64         %rd4, %rd1, %rd4;
    mul.wide.u32    %rd5, %r4, 4;
    add.s64         %rd4, %rd4, %rd5;
    ld.global.nc.s32 %r5, [%rd4];           // e
    ld.param.u32    %r6, [P+104];           // n_w
    ld.param.u32    %r7, [P+100];           // vram_below
    setp.lt.s32     %p1, %r5, 0;
    setp.ge.s32     %p2, %r5, %r6;
    or.pred         %p1, %p1, %p2;
    setp.ge.s32     %p2, %r5, %r7;
    or.pred         %p1, %p1, %p2;
    ld.param.u32    %r8, [P+108];           // part
    setp.eq.s32     %p2, %r8, 2;
    or.pred         %p1, %p1, %p2;
    setp.eq.s32     %p2, %r8, 4;
    or.pred         %p1, %p1, %p2;
    @%p1 bra        DONE;                   // uniform over the CTA

    // This lane's row and place in it.
    ld.param.u32    %r9, [P+116];           // lshift
    mov.u32         %r10, %tid.x;
    shr.u32         %r11, %r10, 5;          // warp
    and.b32         %r12, %r10, 31;         // lane
    mov.u32         %r13, 1;
    shl.b32         %r14, %r13, %r9;        // L
    add.s32         %r15, %r14, -1;
    and.b32         %r16, %r12, %r15;       // sub
    mov.u32         %r17, 32;
    shr.u32         %r18, %r17, %r9;        // rows per warp
    shl.b32         %r19, %r18, 2;          // rows per CTA
    mov.u32         %r20, %ctaid.x;
    mul.lo.s32      %r21, %r20, %r19;
    mad.lo.s32      %r21, %r11, %r18, %r21;
    shr.u32         %r22, %r12, %r9;
    add.s32         %r23, %r21, %r22;       // r
    ld.param.u32    %r24, [P+88];           // rows
    setp.lt.s32     %p3, %r23, %r24;        // this lane's row exists
    add.s32         %r25, %r24, -1;
    min.s32         %r26, %r23, %r25;       // a row to address (loads stay in bounds)

    // The expert's row(s).
    ld.param.u64    %rd6, [P+0];
    ld.param.u64    %rd8, [P+16];           // w_nb1
    ld.param.u64    %rd9, [P+24];           // w_nb2
    cvt.s64.s32     %rd10, %r5;
    mul.lo.s64      %rd10, %rd10, %rd9;
    cvt.s64.s32     %rd11, %r26;
    mad.lo.s64      %rd10, %rd11, %rd8, %rd10;
    add.s64         %rd12, %rd6, %rd10;     // (gate) row
    ld.param.u64    %rd7, [P+8];
    add.s64         %rd13, %rd7, %rd10;     // up row

    ld.param.u32    %r29, [P+112];          // units
    ld.param.u32    %r27, [P+96];           // n_x
    setp.eq.s32     %p4, %r27, 1;
    ld.param.u64    %rd14, [P+32];          // xq
    ld.param.u64    %rd15, [P+40];          // xq_col
    mov.u32         %ruq0, %r1;
    // One user: q.

U1:
    div.u32         %rut0, %ruq0, %r2;
    rem.u32         %ruj0, %ruq0, %r2;
    selp.b32        %rux0, 0, %ruj0, %p4;
    mad.lo.s32      %rux0, %rut0, %r27, %rux0;
    cvt.u64.u32     %ruy0, %rux0;
    mad.lo.s64      %ruy0, %ruy0, %rd15, %rd14;     // y_0
    mov.f32         %fag0, 0f00000000;
    mov.f32         %fau0, 0f00000000;
    selp.b32        %r30, %r16, %r29, %p3;  // c: rows past the end take no units
    setp.ge.s32     %p5, %r30, %r29;
    @%p5 bra        REDUCEU1;
LOOPU1:
    // Unit c: block kbx = c / 16, h = c % 16.
    shr.u32         %r31, %r30, 4;          // kbx
    and.b32         %r32, %r30, 15;         // h
    shr.u32         %r33, %r32, 2;          // h / 4
    shl.b32         %r34, %r33, 1;          // bq8_offset
    and.b32         %r35, %r32, 3;          // h % 4
    mul.wide.u32    %rd18, %r31, 144;
    // nibble ints: 16 + 16 * bq8_offset + 4 * (h % 4) = 16 + 32 * (h / 4) + 4 * (h % 4)
    shl.b32         %r36, %r33, 5;
    shl.b32         %r37, %r35, 2;
    add.s32         %r38, %r36, %r37;
    add.s32         %r38, %r38, 16;
    cvt.u64.u32     %rd19, %r38;
    add.s64         %rd20, %rd12, %rd18;    // gate block
    add.s64         %rd21, %rd13, %rd18;    // up block
    add.s64         %rd22, %rd20, %rd19;
    add.s64         %rd23, %rd21, %rd19;
    // Activations: blocks kbx * 8 + bq8_offset and +1, ints (h % 4) and (h % 4) + 4 of each.
    shl.b32         %r39, %r31, 3;
    add.s32         %r39, %r39, %r34;
    mul.wide.u32    %rd24, %r39, 36;
    cvt.u64.u32     %rd25, %r37;
    add.s64         %rd26, %rd24, %rd25;

    // Every load of the unit first.
    ld.global.nc.v4.u32 {%r40, %r41, %r42, %r43}, [%rd20];   // gate dm, scales
    ld.global.nc.u32    %r44, [%rd22];                       // gate v[0]
    ld.global.nc.u32    %r45, [%rd22+16];                    // gate v[1]
    ld.global.nc.v4.u32 {%r46, %r47, %r48, %r49}, [%rd21];   // up dm, scales
    ld.global.nc.u32    %r50, [%rd23];
    ld.global.nc.u32    %r51, [%rd23+16];
    add.s64         %rdb0, %ruy0, %rd24;     // user 0: block bq8_offset
    add.s64         %rdi0, %ruy0, %rd26;
    ld.global.nc.u32    %xa0, [%rdb0];                     // ds of block bq8_offset
    ld.global.nc.u32    %xa1, [%rdi0+4];                   // u[0]
    ld.global.nc.u32    %xa2, [%rdi0+20];                  // u[1]
    ld.global.nc.u32    %xa3, [%rdb0+36];                  // ds of block bq8_offset + 1
    ld.global.nc.u32    %xa4, [%rdi0+40];                  // u[2]
    ld.global.nc.u32    %xa5, [%rdi0+56];                  // u[3]

    // The weights' scales, mins and nibbles: the scale pair j = bq8_offset / 2 = h / 4, the u16s
    // at 16 * (j & 1) bits into words 1-3.
    and.b32         %r60, %r33, 1;
    shl.b32         %r60, %r60, 4;          // 16 * jm
    setp.ge.u32     %p6, %r33, 2;           // hi form
    // ---- gate ----
    shr.u32         %r61, %r41, %r60;       // s0
    shr.u32         %r62, %r42, %r60;       // s2
    shr.u32         %r63, %r43, %r60;       // s4
    // aux0: lo (s0 & 0x3f3f), hi ((s4 & 0x0f0f) | ((s0 & 0xc0c0) >> 2))
    and.b32         %r64, %r61, 16191;
    and.b32         %r65, %r63, 3855;
    and.b32         %r66, %r61, 49344;
    shr.u32         %r66, %r66, 2;
    or.b32          %r65, %r65, %r66;
    selp.b32        %r67, %r65, %r64, %p6;
    // aux1: lo (s2 & 0x3f3f), hi (((s4 >> 4) & 0x0f0f) | ((s2 & 0xc0c0) >> 2))
    and.b32         %r68, %r62, 16191;
    shr.u32         %r69, %r63, 4;
    and.b32         %r69, %r69, 3855;
    and.b32         %r70, %r62, 49344;
    shr.u32         %r70, %r70, 2;
    or.b32          %r69, %r69, %r70;
    selp.b32        %r71, %r69, %r68, %p6;
    // sc[0], sc[1], m[0], m[1]
    and.b32         %r72, %r67, 63;
    bfe.u32         %r73, %r67, 8, 8;
    and.b32         %r74, %r71, 63;
    bfe.u32         %r75, %r71, 8, 8;
    and.b32         %r76, %r44, 252645135;  // v[0] & 0x0f0f0f0f
    and.b32         %r77, %r45, 252645135;
    shr.u32         %r81, %r44, 4;          // (v[0] >> 4) & 0x0f0f0f0f
    and.b32         %r81, %r81, 252645135;
    shr.u32         %r82, %r45, 4;
    and.b32         %r82, %r82, 252645135;
    {
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %r40;
    cvt.f32.f16     %f11, lo;               // dm.x
    cvt.f32.f16     %f12, hi;               // dm.y
    }
    // ---- up ----
    shr.u32         %r86, %r47, %r60;
    shr.u32         %r87, %r48, %r60;
    shr.u32         %r88, %r49, %r60;
    and.b32         %r89, %r86, 16191;
    and.b32         %r90, %r88, 3855;
    and.b32         %r91, %r86, 49344;
    shr.u32         %r91, %r91, 2;
    or.b32          %r90, %r90, %r91;
    selp.b32        %r92, %r90, %r89, %p6;
    and.b32         %r93, %r87, 16191;
    shr.u32         %r94, %r88, 4;
    and.b32         %r94, %r94, 3855;
    and.b32         %r95, %r87, 49344;
    shr.u32         %r95, %r95, 2;
    or.b32          %r94, %r94, %r95;
    selp.b32        %r96, %r94, %r93, %p6;
    and.b32         %r97, %r92, 63;
    bfe.u32         %r98, %r92, 8, 8;
    and.b32         %r99, %r96, 63;
    bfe.u32         %r100, %r96, 8, 8;
    and.b32         %r101, %r50, 252645135;
    and.b32         %r102, %r51, 252645135;
    shr.u32         %r106, %r50, 4;
    and.b32         %r106, %r106, 252645135;
    shr.u32         %r107, %r51, 4;
    and.b32         %r107, %r107, 252645135;
    {
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %r46;
    cvt.f32.f16     %f21, lo;
    cvt.f32.f16     %f22, hi;
    }

    // ---- user 0 ----
    {
    .reg .b32 dot2a, dot2b, t0, t1;
    .reg .f32 d80, d81, x, sd, sm;
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %xa0;
    cvt.f32.f16     d80, lo;                // d8[0]
    mov.b32         {lo, hi}, %xa3;
    cvt.f32.f16     d81, lo;                // d8[1]
    dp4a.s32.s32    dot2a, 16843009, %xa1, 0;
    dp4a.s32.s32    dot2a, 16843009, %xa2, dot2a;   // dot2, i = 0
    dp4a.s32.s32    dot2b, 16843009, %xa4, 0;
    dp4a.s32.s32    dot2b, 16843009, %xa5, dot2b;   // dot2, i = 1
    // gate: i = 0
    dp4a.s32.s32    t0, %r76, %xa1, 0;
    dp4a.s32.s32    t0, %r77, %xa2, t0;
    mul.lo.s32      t0, t0, %r72;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d80, x, 0f00000000;     // sumf_d
    mul.lo.s32      t1, dot2a, %r74;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d80, x, 0f00000000;     // sumf_m
    // gate: i = 1
    dp4a.s32.s32    t0, %r81, %xa4, 0;
    dp4a.s32.s32    t0, %r82, %xa5, t0;
    mul.lo.s32      t0, t0, %r73;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d81, x, sd;
    mul.lo.s32      t1, dot2b, %r75;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d81, x, sm;
    // dm.x * sumf_d - dm.y * sumf_m
    mul.rn.ftz.f32  x, sm, %f12;
    neg.ftz.f32     x, x;
    fma.rn.ftz.f32  x, sd, %f11, x;
    add.rn.ftz.f32  %fag0, %fag0, x;
    // up: i = 0
    dp4a.s32.s32    t0, %r101, %xa1, 0;
    dp4a.s32.s32    t0, %r102, %xa2, t0;
    mul.lo.s32      t0, t0, %r97;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d80, x, 0f00000000;     // sumf_d
    mul.lo.s32      t1, dot2a, %r99;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d80, x, 0f00000000;     // sumf_m
    // up: i = 1
    dp4a.s32.s32    t0, %r106, %xa4, 0;
    dp4a.s32.s32    t0, %r107, %xa5, t0;
    mul.lo.s32      t0, t0, %r98;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d81, x, sd;
    mul.lo.s32      t1, dot2b, %r100;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d81, x, sm;
    // dm.x * sumf_d - dm.y * sumf_m
    mul.rn.ftz.f32  x, sm, %f22;
    neg.ftz.f32     x, x;
    fma.rn.ftz.f32  x, sd, %f21, x;
    add.rn.ftz.f32  %fau0, %fau0, x;
    }

    add.s32         %r30, %r30, %r14;
    setp.lt.s32     %p7, %r30, %r29;
    @%p7 bra        LOOPU1;

REDUCEU1:
    // sum_lanes: offsets L / 2 .. 1 (L is warp-uniform).
    shr.u32         %r111, %r14, 1;
    setp.eq.s32     %p8, %r111, 0;
    @%p8 bra        STOREU1;
RLOOPU1:
    mov.b32         %r112, %fag0;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fag0, %fag0, %f40;
    mov.b32         %r112, %fau0;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fau0, %fau0, %f40;
    shr.u32         %r111, %r111, 1;
    setp.ne.s32     %p8, %r111, 0;
    @%p8 bra        RLOOPU1;
STOREU1:
    setp.ne.s32     %p9, %r16, 0;
    not.pred        %p10, %p3;
    or.pred         %p9, %p9, %p10;
    @%p9 bra        NEXT;
    ld.param.u64    %rd30, [P+64];
    ld.param.u64    %rd31, [P+72];
    ld.param.u64    %rd32, [P+80];
    mul.wide.s32    %rd34, %r23, 4;
    add.s64         %rd30, %rd30, %rd34;
    ld.param.f32    %f27, [P+120];
    setp.gt.ftz.f32 %p11, %f27, 0f00000000;
    neg.ftz.f32     %f28, %f27;
    // user 0: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj0;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut0;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    // The clamp (GLM-5's swiglu_limit), then silu(g) * u.
    mov.f32         %f29, %fag0;
    mov.f32         %f30, %fau0;
    @!%p11 bra      SILUU1_0;
    min.ftz.f32     %f29, %f29, %f27;
    max.ftz.f32     %f30, %f30, %f28;
    min.ftz.f32     %f30, %f30, %f27;
SILUU1_0:
    mul.rn.ftz.f32  %f31, %f29, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f31, %f31;
    add.rn.ftz.f32  %f32, %f31, 0f3F800000;
    div.approx.ftz.f32 %f33, %f29, %f32;
    mul.rn.ftz.f32  %f34, %f30, %f33;
    st.global.f32   [%rd35], %f34;
    bra.uni         NEXT;

NEXT:
DONE:
    ret;
}

// The same with every user of the expert (steps of several tokens): a code path per user count,
// so a CTA's registers are the most users' and the one-token entry above stays lean.
.visible .entry legion_ptx_q4k_glu_users(
    .param .align 8 .b8 P[128]
)
.maxntid 128, 1, 1
.minnctapersm 8
{
    .reg .pred  %p<12>;
    .reg .b32   %r<120>;
    .reg .b64   %rd<40>;
    .reg .f32   %f<48>;
    .reg .b32   %rnt, %rnp, %rskip, %rnu, %rtot, %rbase;
    .reg .b32   %rsq, %rsid, %rst, %rsj, %rsm, %rsl, %rslo, %rse, %rsb;
    .reg .b64   %rds1, %rds2;
    .reg .b32   %ruq<4>, %rut<4>, %ruj<4>, %rux<4>;
    .reg .b64   %ruy<4>, %rdb<4>, %rdi<4>;
    .reg .b32   %xa<24>;
    .reg .f32   %fag<4>, %fau<4>;

    // The pair q and its expert e.
    mov.u32         %r1, %ctaid.y;
    ld.param.u32    %r2, [P+92];            // n_used
    div.u32         %r3, %r1, %r2;          // t
    rem.u32         %r4, %r1, %r2;          // j
    ld.param.u64    %rd1, [P+48];           // ids
    ld.param.u64    %rd2, [P+56];           // ids_nb1
    cvt.u64.u32     %rd3, %r3;
    mul.lo.s64      %rd4, %rd3, %rd2;
    add.s64         %rd4, %rd1, %rd4;
    mul.wide.u32    %rd5, %r4, 4;
    add.s64         %rd4, %rd4, %rd5;
    ld.global.nc.s32 %r5, [%rd4];           // e
    ld.param.u32    %r6, [P+104];           // n_w
    ld.param.u32    %r7, [P+100];           // vram_below
    setp.lt.s32     %p1, %r5, 0;
    setp.ge.s32     %p2, %r5, %r6;
    or.pred         %p1, %p1, %p2;
    setp.ge.s32     %p2, %r5, %r7;
    or.pred         %p1, %p1, %p2;
    ld.param.u32    %r8, [P+108];           // part
    setp.eq.s32     %p2, %r8, 2;
    or.pred         %p1, %p1, %p2;
    setp.eq.s32     %p2, %r8, 4;
    or.pred         %p1, %p1, %p2;
    @%p1 bra        DONE;                   // uniform over the CTA

    // This lane's row and place in it.
    ld.param.u32    %r9, [P+116];           // lshift
    mov.u32         %r10, %tid.x;
    shr.u32         %r11, %r10, 5;          // warp
    and.b32         %r12, %r10, 31;         // lane
    mov.u32         %r13, 1;
    shl.b32         %r14, %r13, %r9;        // L
    add.s32         %r15, %r14, -1;
    and.b32         %r16, %r12, %r15;       // sub
    mov.u32         %r17, 32;
    shr.u32         %r18, %r17, %r9;        // rows per warp
    shl.b32         %r19, %r18, 2;          // rows per CTA
    mov.u32         %r20, %ctaid.x;
    mul.lo.s32      %r21, %r20, %r19;
    mad.lo.s32      %r21, %r11, %r18, %r21;
    shr.u32         %r22, %r12, %r9;
    add.s32         %r23, %r21, %r22;       // r
    ld.param.u32    %r24, [P+88];           // rows
    setp.lt.s32     %p3, %r23, %r24;        // this lane's row exists
    add.s32         %r25, %r24, -1;
    min.s32         %r26, %r23, %r25;       // a row to address (loads stay in bounds)

    // The expert's row(s).
    ld.param.u64    %rd6, [P+0];
    ld.param.u64    %rd8, [P+16];           // w_nb1
    ld.param.u64    %rd9, [P+24];           // w_nb2
    cvt.s64.s32     %rd10, %r5;
    mul.lo.s64      %rd10, %rd10, %rd9;
    cvt.s64.s32     %rd11, %r26;
    mad.lo.s64      %rd10, %rd11, %rd8, %rd10;
    add.s64         %rd12, %rd6, %rd10;     // (gate) row
    ld.param.u64    %rd7, [P+8];
    add.s64         %rd13, %rd7, %rd10;     // up row

    ld.param.u32    %r29, [P+112];          // units
    ld.param.u32    %r27, [P+96];           // n_x
    setp.eq.s32     %p4, %r27, 1;
    ld.param.u64    %rd14, [P+32];          // xq
    ld.param.u64    %rd15, [P+40];          // xq_col
    mov.u32         %ruq0, %r1;

    // The users: the pairs from q on that chose e (none before q: the first pair's CTAs take
    // them all), MAX_USERS per round, `skip` done so far.
    ld.param.u32    %rnt, [P+124];          // n_tok
    mul.lo.s32      %rnp, %r2, %rnt;        // pairs
    mov.u32         %rskip, 0;
SCAN:
    mov.u32         %rnu, 0;
    mov.u32         %rtot, 0;
    mov.u32         %rbase, 0;
SLOOP:
    // Pair base + lane's id, a ballot of those that are e.
    add.s32         %rsq, %rbase, %r12;
    mov.u32         %rsid, -1;
    setp.lt.s32     %p1, %rsq, %rnp;
    @!%p1 bra       SBALLOT;
    div.u32         %rst, %rsq, %r2;
    rem.u32         %rsj, %rsq, %r2;
    cvt.u64.u32     %rds1, %rst;
    mul.lo.s64      %rds1, %rds1, %rd2;
    add.s64         %rds1, %rd1, %rds1;
    mul.wide.u32    %rds2, %rsj, 4;
    add.s64         %rds1, %rds1, %rds2;
    ld.global.nc.s32 %rsid, [%rds1];
SBALLOT:
    setp.eq.s32     %p1, %rsid, %r5;
    vote.sync.ballot.b32 %rsm, %p1, -1;
    // Bits of pairs before q: (1 << clamp(q - base, 0, 32)) - 1 (a shift by 32 gives 0).
    sub.s32         %rsl, %r1, %rbase;
    max.s32         %rsl, %rsl, 0;
    min.s32         %rsl, %rsl, 32;
    shl.b32         %rslo, %r13, %rsl;
    add.s32         %rslo, %rslo, -1;
    and.b32         %rse, %rsm, %rslo;
    setp.ne.s32     %p1, %rse, 0;
    @%p1 bra        DONE;                   // an earlier pair's (uniform)
    not.b32         %rslo, %rslo;
    and.b32         %rsm, %rsm, %rslo;
SBIT:
    setp.eq.s32     %p1, %rsm, 0;
    @%p1 bra        SNEXT;
    neg.s32         %rse, %rsm;
    and.b32         %rse, %rsm, %rse;       // lowest bit
    xor.b32         %rsm, %rsm, %rse;
    bfind.u32       %rsb, %rse;
    add.s32         %rsq, %rbase, %rsb;     // a user
    setp.ge.s32     %p1, %rtot, %rskip;
    setp.lt.s32     %p2, %rnu, 4;
    and.pred        %p1, %p1, %p2;          // in this round
    setp.eq.s32     %p2, %rnu, 0;
    and.pred        %p2, %p2, %p1;
    @%p2 mov.u32    %ruq0, %rsq;
    setp.eq.s32     %p2, %rnu, 1;
    and.pred        %p2, %p2, %p1;
    @%p2 mov.u32    %ruq1, %rsq;
    setp.eq.s32     %p2, %rnu, 2;
    and.pred        %p2, %p2, %p1;
    @%p2 mov.u32    %ruq2, %rsq;
    setp.eq.s32     %p2, %rnu, 3;
    and.pred        %p2, %p2, %p1;
    @%p2 mov.u32    %ruq3, %rsq;
    @%p1 add.s32    %rnu, %rnu, 1;
    add.s32         %rtot, %rtot, 1;
    bra.uni         SBIT;
SNEXT:
    add.s32         %rbase, %rbase, 32;
    setp.lt.s32     %p1, %rbase, %rnp;
    @%p1 bra        SLOOP;
DISPATCH:
    setp.eq.s32     %p1, %rnu, 0;
    @%p1 bra        DONE;
    setp.eq.s32     %p1, %rnu, 1;
    @%p1 bra        U1;
    setp.eq.s32     %p1, %rnu, 2;
    @%p1 bra        U2;
    setp.eq.s32     %p1, %rnu, 3;
    @%p1 bra        U3;
    bra.uni         U4;

U1:
    div.u32         %rut0, %ruq0, %r2;
    rem.u32         %ruj0, %ruq0, %r2;
    selp.b32        %rux0, 0, %ruj0, %p4;
    mad.lo.s32      %rux0, %rut0, %r27, %rux0;
    cvt.u64.u32     %ruy0, %rux0;
    mad.lo.s64      %ruy0, %ruy0, %rd15, %rd14;     // y_0
    mov.f32         %fag0, 0f00000000;
    mov.f32         %fau0, 0f00000000;
    selp.b32        %r30, %r16, %r29, %p3;  // c: rows past the end take no units
    setp.ge.s32     %p5, %r30, %r29;
    @%p5 bra        REDUCEU1;
LOOPU1:
    // Unit c: block kbx = c / 16, h = c % 16.
    shr.u32         %r31, %r30, 4;          // kbx
    and.b32         %r32, %r30, 15;         // h
    shr.u32         %r33, %r32, 2;          // h / 4
    shl.b32         %r34, %r33, 1;          // bq8_offset
    and.b32         %r35, %r32, 3;          // h % 4
    mul.wide.u32    %rd18, %r31, 144;
    // nibble ints: 16 + 16 * bq8_offset + 4 * (h % 4) = 16 + 32 * (h / 4) + 4 * (h % 4)
    shl.b32         %r36, %r33, 5;
    shl.b32         %r37, %r35, 2;
    add.s32         %r38, %r36, %r37;
    add.s32         %r38, %r38, 16;
    cvt.u64.u32     %rd19, %r38;
    add.s64         %rd20, %rd12, %rd18;    // gate block
    add.s64         %rd21, %rd13, %rd18;    // up block
    add.s64         %rd22, %rd20, %rd19;
    add.s64         %rd23, %rd21, %rd19;
    // Activations: blocks kbx * 8 + bq8_offset and +1, ints (h % 4) and (h % 4) + 4 of each.
    shl.b32         %r39, %r31, 3;
    add.s32         %r39, %r39, %r34;
    mul.wide.u32    %rd24, %r39, 36;
    cvt.u64.u32     %rd25, %r37;
    add.s64         %rd26, %rd24, %rd25;

    // Every load of the unit first.
    ld.global.nc.v4.u32 {%r40, %r41, %r42, %r43}, [%rd20];   // gate dm, scales
    ld.global.nc.u32    %r44, [%rd22];                       // gate v[0]
    ld.global.nc.u32    %r45, [%rd22+16];                    // gate v[1]
    ld.global.nc.v4.u32 {%r46, %r47, %r48, %r49}, [%rd21];   // up dm, scales
    ld.global.nc.u32    %r50, [%rd23];
    ld.global.nc.u32    %r51, [%rd23+16];
    add.s64         %rdb0, %ruy0, %rd24;     // user 0: block bq8_offset
    add.s64         %rdi0, %ruy0, %rd26;
    ld.global.nc.u32    %xa0, [%rdb0];                     // ds of block bq8_offset
    ld.global.nc.u32    %xa1, [%rdi0+4];                   // u[0]
    ld.global.nc.u32    %xa2, [%rdi0+20];                  // u[1]
    ld.global.nc.u32    %xa3, [%rdb0+36];                  // ds of block bq8_offset + 1
    ld.global.nc.u32    %xa4, [%rdi0+40];                  // u[2]
    ld.global.nc.u32    %xa5, [%rdi0+56];                  // u[3]

    // The weights' scales, mins and nibbles: the scale pair j = bq8_offset / 2 = h / 4, the u16s
    // at 16 * (j & 1) bits into words 1-3.
    and.b32         %r60, %r33, 1;
    shl.b32         %r60, %r60, 4;          // 16 * jm
    setp.ge.u32     %p6, %r33, 2;           // hi form
    // ---- gate ----
    shr.u32         %r61, %r41, %r60;       // s0
    shr.u32         %r62, %r42, %r60;       // s2
    shr.u32         %r63, %r43, %r60;       // s4
    // aux0: lo (s0 & 0x3f3f), hi ((s4 & 0x0f0f) | ((s0 & 0xc0c0) >> 2))
    and.b32         %r64, %r61, 16191;
    and.b32         %r65, %r63, 3855;
    and.b32         %r66, %r61, 49344;
    shr.u32         %r66, %r66, 2;
    or.b32          %r65, %r65, %r66;
    selp.b32        %r67, %r65, %r64, %p6;
    // aux1: lo (s2 & 0x3f3f), hi (((s4 >> 4) & 0x0f0f) | ((s2 & 0xc0c0) >> 2))
    and.b32         %r68, %r62, 16191;
    shr.u32         %r69, %r63, 4;
    and.b32         %r69, %r69, 3855;
    and.b32         %r70, %r62, 49344;
    shr.u32         %r70, %r70, 2;
    or.b32          %r69, %r69, %r70;
    selp.b32        %r71, %r69, %r68, %p6;
    // sc[0], sc[1], m[0], m[1]
    and.b32         %r72, %r67, 63;
    bfe.u32         %r73, %r67, 8, 8;
    and.b32         %r74, %r71, 63;
    bfe.u32         %r75, %r71, 8, 8;
    and.b32         %r76, %r44, 252645135;  // v[0] & 0x0f0f0f0f
    and.b32         %r77, %r45, 252645135;
    shr.u32         %r81, %r44, 4;          // (v[0] >> 4) & 0x0f0f0f0f
    and.b32         %r81, %r81, 252645135;
    shr.u32         %r82, %r45, 4;
    and.b32         %r82, %r82, 252645135;
    {
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %r40;
    cvt.f32.f16     %f11, lo;               // dm.x
    cvt.f32.f16     %f12, hi;               // dm.y
    }
    // ---- up ----
    shr.u32         %r86, %r47, %r60;
    shr.u32         %r87, %r48, %r60;
    shr.u32         %r88, %r49, %r60;
    and.b32         %r89, %r86, 16191;
    and.b32         %r90, %r88, 3855;
    and.b32         %r91, %r86, 49344;
    shr.u32         %r91, %r91, 2;
    or.b32          %r90, %r90, %r91;
    selp.b32        %r92, %r90, %r89, %p6;
    and.b32         %r93, %r87, 16191;
    shr.u32         %r94, %r88, 4;
    and.b32         %r94, %r94, 3855;
    and.b32         %r95, %r87, 49344;
    shr.u32         %r95, %r95, 2;
    or.b32          %r94, %r94, %r95;
    selp.b32        %r96, %r94, %r93, %p6;
    and.b32         %r97, %r92, 63;
    bfe.u32         %r98, %r92, 8, 8;
    and.b32         %r99, %r96, 63;
    bfe.u32         %r100, %r96, 8, 8;
    and.b32         %r101, %r50, 252645135;
    and.b32         %r102, %r51, 252645135;
    shr.u32         %r106, %r50, 4;
    and.b32         %r106, %r106, 252645135;
    shr.u32         %r107, %r51, 4;
    and.b32         %r107, %r107, 252645135;
    {
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %r46;
    cvt.f32.f16     %f21, lo;
    cvt.f32.f16     %f22, hi;
    }

    // ---- user 0 ----
    {
    .reg .b32 dot2a, dot2b, t0, t1;
    .reg .f32 d80, d81, x, sd, sm;
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %xa0;
    cvt.f32.f16     d80, lo;                // d8[0]
    mov.b32         {lo, hi}, %xa3;
    cvt.f32.f16     d81, lo;                // d8[1]
    dp4a.s32.s32    dot2a, 16843009, %xa1, 0;
    dp4a.s32.s32    dot2a, 16843009, %xa2, dot2a;   // dot2, i = 0
    dp4a.s32.s32    dot2b, 16843009, %xa4, 0;
    dp4a.s32.s32    dot2b, 16843009, %xa5, dot2b;   // dot2, i = 1
    // gate: i = 0
    dp4a.s32.s32    t0, %r76, %xa1, 0;
    dp4a.s32.s32    t0, %r77, %xa2, t0;
    mul.lo.s32      t0, t0, %r72;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d80, x, 0f00000000;     // sumf_d
    mul.lo.s32      t1, dot2a, %r74;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d80, x, 0f00000000;     // sumf_m
    // gate: i = 1
    dp4a.s32.s32    t0, %r81, %xa4, 0;
    dp4a.s32.s32    t0, %r82, %xa5, t0;
    mul.lo.s32      t0, t0, %r73;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d81, x, sd;
    mul.lo.s32      t1, dot2b, %r75;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d81, x, sm;
    // dm.x * sumf_d - dm.y * sumf_m
    mul.rn.ftz.f32  x, sm, %f12;
    neg.ftz.f32     x, x;
    fma.rn.ftz.f32  x, sd, %f11, x;
    add.rn.ftz.f32  %fag0, %fag0, x;
    // up: i = 0
    dp4a.s32.s32    t0, %r101, %xa1, 0;
    dp4a.s32.s32    t0, %r102, %xa2, t0;
    mul.lo.s32      t0, t0, %r97;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d80, x, 0f00000000;     // sumf_d
    mul.lo.s32      t1, dot2a, %r99;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d80, x, 0f00000000;     // sumf_m
    // up: i = 1
    dp4a.s32.s32    t0, %r106, %xa4, 0;
    dp4a.s32.s32    t0, %r107, %xa5, t0;
    mul.lo.s32      t0, t0, %r98;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d81, x, sd;
    mul.lo.s32      t1, dot2b, %r100;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d81, x, sm;
    // dm.x * sumf_d - dm.y * sumf_m
    mul.rn.ftz.f32  x, sm, %f22;
    neg.ftz.f32     x, x;
    fma.rn.ftz.f32  x, sd, %f21, x;
    add.rn.ftz.f32  %fau0, %fau0, x;
    }

    add.s32         %r30, %r30, %r14;
    setp.lt.s32     %p7, %r30, %r29;
    @%p7 bra        LOOPU1;

REDUCEU1:
    // sum_lanes: offsets L / 2 .. 1 (L is warp-uniform).
    shr.u32         %r111, %r14, 1;
    setp.eq.s32     %p8, %r111, 0;
    @%p8 bra        STOREU1;
RLOOPU1:
    mov.b32         %r112, %fag0;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fag0, %fag0, %f40;
    mov.b32         %r112, %fau0;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fau0, %fau0, %f40;
    shr.u32         %r111, %r111, 1;
    setp.ne.s32     %p8, %r111, 0;
    @%p8 bra        RLOOPU1;
STOREU1:
    setp.ne.s32     %p9, %r16, 0;
    not.pred        %p10, %p3;
    or.pred         %p9, %p9, %p10;
    @%p9 bra        NEXT;
    ld.param.u64    %rd30, [P+64];
    ld.param.u64    %rd31, [P+72];
    ld.param.u64    %rd32, [P+80];
    mul.wide.s32    %rd34, %r23, 4;
    add.s64         %rd30, %rd30, %rd34;
    ld.param.f32    %f27, [P+120];
    setp.gt.ftz.f32 %p11, %f27, 0f00000000;
    neg.ftz.f32     %f28, %f27;
    // user 0: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj0;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut0;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    // The clamp (GLM-5's swiglu_limit), then silu(g) * u.
    mov.f32         %f29, %fag0;
    mov.f32         %f30, %fau0;
    @!%p11 bra      SILUU1_0;
    min.ftz.f32     %f29, %f29, %f27;
    max.ftz.f32     %f30, %f30, %f28;
    min.ftz.f32     %f30, %f30, %f27;
SILUU1_0:
    mul.rn.ftz.f32  %f31, %f29, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f31, %f31;
    add.rn.ftz.f32  %f32, %f31, 0f3F800000;
    div.approx.ftz.f32 %f33, %f29, %f32;
    mul.rn.ftz.f32  %f34, %f30, %f33;
    st.global.f32   [%rd35], %f34;
    bra.uni         NEXT;

U2:
    div.u32         %rut0, %ruq0, %r2;
    rem.u32         %ruj0, %ruq0, %r2;
    selp.b32        %rux0, 0, %ruj0, %p4;
    mad.lo.s32      %rux0, %rut0, %r27, %rux0;
    cvt.u64.u32     %ruy0, %rux0;
    mad.lo.s64      %ruy0, %ruy0, %rd15, %rd14;     // y_0
    div.u32         %rut1, %ruq1, %r2;
    rem.u32         %ruj1, %ruq1, %r2;
    selp.b32        %rux1, 0, %ruj1, %p4;
    mad.lo.s32      %rux1, %rut1, %r27, %rux1;
    cvt.u64.u32     %ruy1, %rux1;
    mad.lo.s64      %ruy1, %ruy1, %rd15, %rd14;     // y_1
    mov.f32         %fag0, 0f00000000;
    mov.f32         %fau0, 0f00000000;
    mov.f32         %fag1, 0f00000000;
    mov.f32         %fau1, 0f00000000;
    selp.b32        %r30, %r16, %r29, %p3;  // c: rows past the end take no units
    setp.ge.s32     %p5, %r30, %r29;
    @%p5 bra        REDUCEU2;
LOOPU2:
    // Unit c: block kbx = c / 16, h = c % 16.
    shr.u32         %r31, %r30, 4;          // kbx
    and.b32         %r32, %r30, 15;         // h
    shr.u32         %r33, %r32, 2;          // h / 4
    shl.b32         %r34, %r33, 1;          // bq8_offset
    and.b32         %r35, %r32, 3;          // h % 4
    mul.wide.u32    %rd18, %r31, 144;
    // nibble ints: 16 + 16 * bq8_offset + 4 * (h % 4) = 16 + 32 * (h / 4) + 4 * (h % 4)
    shl.b32         %r36, %r33, 5;
    shl.b32         %r37, %r35, 2;
    add.s32         %r38, %r36, %r37;
    add.s32         %r38, %r38, 16;
    cvt.u64.u32     %rd19, %r38;
    add.s64         %rd20, %rd12, %rd18;    // gate block
    add.s64         %rd21, %rd13, %rd18;    // up block
    add.s64         %rd22, %rd20, %rd19;
    add.s64         %rd23, %rd21, %rd19;
    // Activations: blocks kbx * 8 + bq8_offset and +1, ints (h % 4) and (h % 4) + 4 of each.
    shl.b32         %r39, %r31, 3;
    add.s32         %r39, %r39, %r34;
    mul.wide.u32    %rd24, %r39, 36;
    cvt.u64.u32     %rd25, %r37;
    add.s64         %rd26, %rd24, %rd25;

    // Every load of the unit first.
    ld.global.nc.v4.u32 {%r40, %r41, %r42, %r43}, [%rd20];   // gate dm, scales
    ld.global.nc.u32    %r44, [%rd22];                       // gate v[0]
    ld.global.nc.u32    %r45, [%rd22+16];                    // gate v[1]
    ld.global.nc.v4.u32 {%r46, %r47, %r48, %r49}, [%rd21];   // up dm, scales
    ld.global.nc.u32    %r50, [%rd23];
    ld.global.nc.u32    %r51, [%rd23+16];
    add.s64         %rdb0, %ruy0, %rd24;     // user 0: block bq8_offset
    add.s64         %rdi0, %ruy0, %rd26;
    ld.global.nc.u32    %xa0, [%rdb0];                     // ds of block bq8_offset
    ld.global.nc.u32    %xa1, [%rdi0+4];                   // u[0]
    ld.global.nc.u32    %xa2, [%rdi0+20];                  // u[1]
    ld.global.nc.u32    %xa3, [%rdb0+36];                  // ds of block bq8_offset + 1
    ld.global.nc.u32    %xa4, [%rdi0+40];                  // u[2]
    ld.global.nc.u32    %xa5, [%rdi0+56];                  // u[3]
    add.s64         %rdb1, %ruy1, %rd24;     // user 1: block bq8_offset
    add.s64         %rdi1, %ruy1, %rd26;
    ld.global.nc.u32    %xa6, [%rdb1];                     // ds of block bq8_offset
    ld.global.nc.u32    %xa7, [%rdi1+4];                   // u[0]
    ld.global.nc.u32    %xa8, [%rdi1+20];                  // u[1]
    ld.global.nc.u32    %xa9, [%rdb1+36];                  // ds of block bq8_offset + 1
    ld.global.nc.u32    %xa10, [%rdi1+40];                  // u[2]
    ld.global.nc.u32    %xa11, [%rdi1+56];                  // u[3]

    // The weights' scales, mins and nibbles: the scale pair j = bq8_offset / 2 = h / 4, the u16s
    // at 16 * (j & 1) bits into words 1-3.
    and.b32         %r60, %r33, 1;
    shl.b32         %r60, %r60, 4;          // 16 * jm
    setp.ge.u32     %p6, %r33, 2;           // hi form
    // ---- gate ----
    shr.u32         %r61, %r41, %r60;       // s0
    shr.u32         %r62, %r42, %r60;       // s2
    shr.u32         %r63, %r43, %r60;       // s4
    // aux0: lo (s0 & 0x3f3f), hi ((s4 & 0x0f0f) | ((s0 & 0xc0c0) >> 2))
    and.b32         %r64, %r61, 16191;
    and.b32         %r65, %r63, 3855;
    and.b32         %r66, %r61, 49344;
    shr.u32         %r66, %r66, 2;
    or.b32          %r65, %r65, %r66;
    selp.b32        %r67, %r65, %r64, %p6;
    // aux1: lo (s2 & 0x3f3f), hi (((s4 >> 4) & 0x0f0f) | ((s2 & 0xc0c0) >> 2))
    and.b32         %r68, %r62, 16191;
    shr.u32         %r69, %r63, 4;
    and.b32         %r69, %r69, 3855;
    and.b32         %r70, %r62, 49344;
    shr.u32         %r70, %r70, 2;
    or.b32          %r69, %r69, %r70;
    selp.b32        %r71, %r69, %r68, %p6;
    // sc[0], sc[1], m[0], m[1]
    and.b32         %r72, %r67, 63;
    bfe.u32         %r73, %r67, 8, 8;
    and.b32         %r74, %r71, 63;
    bfe.u32         %r75, %r71, 8, 8;
    and.b32         %r76, %r44, 252645135;  // v[0] & 0x0f0f0f0f
    and.b32         %r77, %r45, 252645135;
    shr.u32         %r81, %r44, 4;          // (v[0] >> 4) & 0x0f0f0f0f
    and.b32         %r81, %r81, 252645135;
    shr.u32         %r82, %r45, 4;
    and.b32         %r82, %r82, 252645135;
    {
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %r40;
    cvt.f32.f16     %f11, lo;               // dm.x
    cvt.f32.f16     %f12, hi;               // dm.y
    }
    // ---- up ----
    shr.u32         %r86, %r47, %r60;
    shr.u32         %r87, %r48, %r60;
    shr.u32         %r88, %r49, %r60;
    and.b32         %r89, %r86, 16191;
    and.b32         %r90, %r88, 3855;
    and.b32         %r91, %r86, 49344;
    shr.u32         %r91, %r91, 2;
    or.b32          %r90, %r90, %r91;
    selp.b32        %r92, %r90, %r89, %p6;
    and.b32         %r93, %r87, 16191;
    shr.u32         %r94, %r88, 4;
    and.b32         %r94, %r94, 3855;
    and.b32         %r95, %r87, 49344;
    shr.u32         %r95, %r95, 2;
    or.b32          %r94, %r94, %r95;
    selp.b32        %r96, %r94, %r93, %p6;
    and.b32         %r97, %r92, 63;
    bfe.u32         %r98, %r92, 8, 8;
    and.b32         %r99, %r96, 63;
    bfe.u32         %r100, %r96, 8, 8;
    and.b32         %r101, %r50, 252645135;
    and.b32         %r102, %r51, 252645135;
    shr.u32         %r106, %r50, 4;
    and.b32         %r106, %r106, 252645135;
    shr.u32         %r107, %r51, 4;
    and.b32         %r107, %r107, 252645135;
    {
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %r46;
    cvt.f32.f16     %f21, lo;
    cvt.f32.f16     %f22, hi;
    }

    // ---- user 0 ----
    {
    .reg .b32 dot2a, dot2b, t0, t1;
    .reg .f32 d80, d81, x, sd, sm;
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %xa0;
    cvt.f32.f16     d80, lo;                // d8[0]
    mov.b32         {lo, hi}, %xa3;
    cvt.f32.f16     d81, lo;                // d8[1]
    dp4a.s32.s32    dot2a, 16843009, %xa1, 0;
    dp4a.s32.s32    dot2a, 16843009, %xa2, dot2a;   // dot2, i = 0
    dp4a.s32.s32    dot2b, 16843009, %xa4, 0;
    dp4a.s32.s32    dot2b, 16843009, %xa5, dot2b;   // dot2, i = 1
    // gate: i = 0
    dp4a.s32.s32    t0, %r76, %xa1, 0;
    dp4a.s32.s32    t0, %r77, %xa2, t0;
    mul.lo.s32      t0, t0, %r72;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d80, x, 0f00000000;     // sumf_d
    mul.lo.s32      t1, dot2a, %r74;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d80, x, 0f00000000;     // sumf_m
    // gate: i = 1
    dp4a.s32.s32    t0, %r81, %xa4, 0;
    dp4a.s32.s32    t0, %r82, %xa5, t0;
    mul.lo.s32      t0, t0, %r73;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d81, x, sd;
    mul.lo.s32      t1, dot2b, %r75;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d81, x, sm;
    // dm.x * sumf_d - dm.y * sumf_m
    mul.rn.ftz.f32  x, sm, %f12;
    neg.ftz.f32     x, x;
    fma.rn.ftz.f32  x, sd, %f11, x;
    add.rn.ftz.f32  %fag0, %fag0, x;
    // up: i = 0
    dp4a.s32.s32    t0, %r101, %xa1, 0;
    dp4a.s32.s32    t0, %r102, %xa2, t0;
    mul.lo.s32      t0, t0, %r97;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d80, x, 0f00000000;     // sumf_d
    mul.lo.s32      t1, dot2a, %r99;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d80, x, 0f00000000;     // sumf_m
    // up: i = 1
    dp4a.s32.s32    t0, %r106, %xa4, 0;
    dp4a.s32.s32    t0, %r107, %xa5, t0;
    mul.lo.s32      t0, t0, %r98;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d81, x, sd;
    mul.lo.s32      t1, dot2b, %r100;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d81, x, sm;
    // dm.x * sumf_d - dm.y * sumf_m
    mul.rn.ftz.f32  x, sm, %f22;
    neg.ftz.f32     x, x;
    fma.rn.ftz.f32  x, sd, %f21, x;
    add.rn.ftz.f32  %fau0, %fau0, x;
    }

    // ---- user 1 ----
    {
    .reg .b32 dot2a, dot2b, t0, t1;
    .reg .f32 d80, d81, x, sd, sm;
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %xa6;
    cvt.f32.f16     d80, lo;                // d8[0]
    mov.b32         {lo, hi}, %xa9;
    cvt.f32.f16     d81, lo;                // d8[1]
    dp4a.s32.s32    dot2a, 16843009, %xa7, 0;
    dp4a.s32.s32    dot2a, 16843009, %xa8, dot2a;   // dot2, i = 0
    dp4a.s32.s32    dot2b, 16843009, %xa10, 0;
    dp4a.s32.s32    dot2b, 16843009, %xa11, dot2b;   // dot2, i = 1
    // gate: i = 0
    dp4a.s32.s32    t0, %r76, %xa7, 0;
    dp4a.s32.s32    t0, %r77, %xa8, t0;
    mul.lo.s32      t0, t0, %r72;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d80, x, 0f00000000;     // sumf_d
    mul.lo.s32      t1, dot2a, %r74;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d80, x, 0f00000000;     // sumf_m
    // gate: i = 1
    dp4a.s32.s32    t0, %r81, %xa10, 0;
    dp4a.s32.s32    t0, %r82, %xa11, t0;
    mul.lo.s32      t0, t0, %r73;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d81, x, sd;
    mul.lo.s32      t1, dot2b, %r75;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d81, x, sm;
    // dm.x * sumf_d - dm.y * sumf_m
    mul.rn.ftz.f32  x, sm, %f12;
    neg.ftz.f32     x, x;
    fma.rn.ftz.f32  x, sd, %f11, x;
    add.rn.ftz.f32  %fag1, %fag1, x;
    // up: i = 0
    dp4a.s32.s32    t0, %r101, %xa7, 0;
    dp4a.s32.s32    t0, %r102, %xa8, t0;
    mul.lo.s32      t0, t0, %r97;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d80, x, 0f00000000;     // sumf_d
    mul.lo.s32      t1, dot2a, %r99;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d80, x, 0f00000000;     // sumf_m
    // up: i = 1
    dp4a.s32.s32    t0, %r106, %xa10, 0;
    dp4a.s32.s32    t0, %r107, %xa11, t0;
    mul.lo.s32      t0, t0, %r98;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d81, x, sd;
    mul.lo.s32      t1, dot2b, %r100;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d81, x, sm;
    // dm.x * sumf_d - dm.y * sumf_m
    mul.rn.ftz.f32  x, sm, %f22;
    neg.ftz.f32     x, x;
    fma.rn.ftz.f32  x, sd, %f21, x;
    add.rn.ftz.f32  %fau1, %fau1, x;
    }

    add.s32         %r30, %r30, %r14;
    setp.lt.s32     %p7, %r30, %r29;
    @%p7 bra        LOOPU2;

REDUCEU2:
    // sum_lanes: offsets L / 2 .. 1 (L is warp-uniform).
    shr.u32         %r111, %r14, 1;
    setp.eq.s32     %p8, %r111, 0;
    @%p8 bra        STOREU2;
RLOOPU2:
    mov.b32         %r112, %fag0;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fag0, %fag0, %f40;
    mov.b32         %r112, %fau0;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fau0, %fau0, %f40;
    mov.b32         %r112, %fag1;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fag1, %fag1, %f40;
    mov.b32         %r112, %fau1;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fau1, %fau1, %f40;
    shr.u32         %r111, %r111, 1;
    setp.ne.s32     %p8, %r111, 0;
    @%p8 bra        RLOOPU2;
STOREU2:
    setp.ne.s32     %p9, %r16, 0;
    not.pred        %p10, %p3;
    or.pred         %p9, %p9, %p10;
    @%p9 bra        NEXT;
    ld.param.u64    %rd30, [P+64];
    ld.param.u64    %rd31, [P+72];
    ld.param.u64    %rd32, [P+80];
    mul.wide.s32    %rd34, %r23, 4;
    add.s64         %rd30, %rd30, %rd34;
    ld.param.f32    %f27, [P+120];
    setp.gt.ftz.f32 %p11, %f27, 0f00000000;
    neg.ftz.f32     %f28, %f27;
    // user 0: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj0;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut0;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    // The clamp (GLM-5's swiglu_limit), then silu(g) * u.
    mov.f32         %f29, %fag0;
    mov.f32         %f30, %fau0;
    @!%p11 bra      SILUU2_0;
    min.ftz.f32     %f29, %f29, %f27;
    max.ftz.f32     %f30, %f30, %f28;
    min.ftz.f32     %f30, %f30, %f27;
SILUU2_0:
    mul.rn.ftz.f32  %f31, %f29, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f31, %f31;
    add.rn.ftz.f32  %f32, %f31, 0f3F800000;
    div.approx.ftz.f32 %f33, %f29, %f32;
    mul.rn.ftz.f32  %f34, %f30, %f33;
    st.global.f32   [%rd35], %f34;
    // user 1: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj1;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut1;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    // The clamp (GLM-5's swiglu_limit), then silu(g) * u.
    mov.f32         %f29, %fag1;
    mov.f32         %f30, %fau1;
    @!%p11 bra      SILUU2_1;
    min.ftz.f32     %f29, %f29, %f27;
    max.ftz.f32     %f30, %f30, %f28;
    min.ftz.f32     %f30, %f30, %f27;
SILUU2_1:
    mul.rn.ftz.f32  %f31, %f29, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f31, %f31;
    add.rn.ftz.f32  %f32, %f31, 0f3F800000;
    div.approx.ftz.f32 %f33, %f29, %f32;
    mul.rn.ftz.f32  %f34, %f30, %f33;
    st.global.f32   [%rd35], %f34;
    bra.uni         NEXT;

U3:
    div.u32         %rut0, %ruq0, %r2;
    rem.u32         %ruj0, %ruq0, %r2;
    selp.b32        %rux0, 0, %ruj0, %p4;
    mad.lo.s32      %rux0, %rut0, %r27, %rux0;
    cvt.u64.u32     %ruy0, %rux0;
    mad.lo.s64      %ruy0, %ruy0, %rd15, %rd14;     // y_0
    div.u32         %rut1, %ruq1, %r2;
    rem.u32         %ruj1, %ruq1, %r2;
    selp.b32        %rux1, 0, %ruj1, %p4;
    mad.lo.s32      %rux1, %rut1, %r27, %rux1;
    cvt.u64.u32     %ruy1, %rux1;
    mad.lo.s64      %ruy1, %ruy1, %rd15, %rd14;     // y_1
    div.u32         %rut2, %ruq2, %r2;
    rem.u32         %ruj2, %ruq2, %r2;
    selp.b32        %rux2, 0, %ruj2, %p4;
    mad.lo.s32      %rux2, %rut2, %r27, %rux2;
    cvt.u64.u32     %ruy2, %rux2;
    mad.lo.s64      %ruy2, %ruy2, %rd15, %rd14;     // y_2
    mov.f32         %fag0, 0f00000000;
    mov.f32         %fau0, 0f00000000;
    mov.f32         %fag1, 0f00000000;
    mov.f32         %fau1, 0f00000000;
    mov.f32         %fag2, 0f00000000;
    mov.f32         %fau2, 0f00000000;
    selp.b32        %r30, %r16, %r29, %p3;  // c: rows past the end take no units
    setp.ge.s32     %p5, %r30, %r29;
    @%p5 bra        REDUCEU3;
LOOPU3:
    // Unit c: block kbx = c / 16, h = c % 16.
    shr.u32         %r31, %r30, 4;          // kbx
    and.b32         %r32, %r30, 15;         // h
    shr.u32         %r33, %r32, 2;          // h / 4
    shl.b32         %r34, %r33, 1;          // bq8_offset
    and.b32         %r35, %r32, 3;          // h % 4
    mul.wide.u32    %rd18, %r31, 144;
    // nibble ints: 16 + 16 * bq8_offset + 4 * (h % 4) = 16 + 32 * (h / 4) + 4 * (h % 4)
    shl.b32         %r36, %r33, 5;
    shl.b32         %r37, %r35, 2;
    add.s32         %r38, %r36, %r37;
    add.s32         %r38, %r38, 16;
    cvt.u64.u32     %rd19, %r38;
    add.s64         %rd20, %rd12, %rd18;    // gate block
    add.s64         %rd21, %rd13, %rd18;    // up block
    add.s64         %rd22, %rd20, %rd19;
    add.s64         %rd23, %rd21, %rd19;
    // Activations: blocks kbx * 8 + bq8_offset and +1, ints (h % 4) and (h % 4) + 4 of each.
    shl.b32         %r39, %r31, 3;
    add.s32         %r39, %r39, %r34;
    mul.wide.u32    %rd24, %r39, 36;
    cvt.u64.u32     %rd25, %r37;
    add.s64         %rd26, %rd24, %rd25;

    // Every load of the unit first.
    ld.global.nc.v4.u32 {%r40, %r41, %r42, %r43}, [%rd20];   // gate dm, scales
    ld.global.nc.u32    %r44, [%rd22];                       // gate v[0]
    ld.global.nc.u32    %r45, [%rd22+16];                    // gate v[1]
    ld.global.nc.v4.u32 {%r46, %r47, %r48, %r49}, [%rd21];   // up dm, scales
    ld.global.nc.u32    %r50, [%rd23];
    ld.global.nc.u32    %r51, [%rd23+16];
    add.s64         %rdb0, %ruy0, %rd24;     // user 0: block bq8_offset
    add.s64         %rdi0, %ruy0, %rd26;
    ld.global.nc.u32    %xa0, [%rdb0];                     // ds of block bq8_offset
    ld.global.nc.u32    %xa1, [%rdi0+4];                   // u[0]
    ld.global.nc.u32    %xa2, [%rdi0+20];                  // u[1]
    ld.global.nc.u32    %xa3, [%rdb0+36];                  // ds of block bq8_offset + 1
    ld.global.nc.u32    %xa4, [%rdi0+40];                  // u[2]
    ld.global.nc.u32    %xa5, [%rdi0+56];                  // u[3]
    add.s64         %rdb1, %ruy1, %rd24;     // user 1: block bq8_offset
    add.s64         %rdi1, %ruy1, %rd26;
    ld.global.nc.u32    %xa6, [%rdb1];                     // ds of block bq8_offset
    ld.global.nc.u32    %xa7, [%rdi1+4];                   // u[0]
    ld.global.nc.u32    %xa8, [%rdi1+20];                  // u[1]
    ld.global.nc.u32    %xa9, [%rdb1+36];                  // ds of block bq8_offset + 1
    ld.global.nc.u32    %xa10, [%rdi1+40];                  // u[2]
    ld.global.nc.u32    %xa11, [%rdi1+56];                  // u[3]
    add.s64         %rdb2, %ruy2, %rd24;     // user 2: block bq8_offset
    add.s64         %rdi2, %ruy2, %rd26;
    ld.global.nc.u32    %xa12, [%rdb2];                     // ds of block bq8_offset
    ld.global.nc.u32    %xa13, [%rdi2+4];                   // u[0]
    ld.global.nc.u32    %xa14, [%rdi2+20];                  // u[1]
    ld.global.nc.u32    %xa15, [%rdb2+36];                  // ds of block bq8_offset + 1
