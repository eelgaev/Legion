    and.b32         %r72, %r67, 63;
    bfe.u32         %r73, %r67, 8, 8;
    and.b32         %r74, %r71, 63;
    bfe.u32         %r75, %r71, 8, 8;
    and.b32         %r76, %r44, 252645135;  // v[0] & 0x0f0f0f0f
    and.b32         %r77, %r45, 252645135;
    shr.u32         %r81, %r44, 4;          // (v[0] >> 4) & 0x0f0f0f0f
    and.b32         %r81, %r81, 252645135;
    shr.u32         %r82, %r45, 4;
    and.b32         %r82, %r82, 252645135;
    {
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %r40;
    cvt.f32.f16     %f11, lo;               // dm.x
    cvt.f32.f16     %f12, hi;               // dm.y
    }
