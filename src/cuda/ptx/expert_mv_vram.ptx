    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d80, x, 0f00000000;     // sumf_m
    // up: i = 1
    dp4a.s32.s32    t0, %r106, %xa16, 0;
    dp4a.s32.s32    t0, %r107, %xa17, t0;
    mul.lo.s32      t0, t0, %r98;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d81, x, sd;
    mul.lo.s32      t1, dot2b, %r100;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d81, x, sm;
    // dm.x * sumf_d - dm.y * sumf_m
    mul.rn.ftz.f32  x, sm, %f22;
    neg.ftz.f32     x, x;
    fma.rn.ftz.f32  x, sd, %f21, x;
    add.rn.ftz.f32  %fau2, %fau2, x;
    }

    // ---- user 3 ----
    {
    .reg .b32 dot2a, dot2b, t0, t1;
    .reg .f32 d80, d81, x, sd, sm;
    .reg .f16 lo, hi;
    mov.b32         {lo, hi}, %xa18;
    cvt.f32.f16     d80, lo;                // d8[0]
    mov.b32         {lo, hi}, %xa21;
    cvt.f32.f16     d81, lo;                // d8[1]
    dp4a.s32.s32    dot2a, 16843009, %xa19, 0;
    dp4a.s32.s32    dot2a, 16843009, %xa20, dot2a;   // dot2, i = 0
    dp4a.s32.s32    dot2b, 16843009, %xa22, 0;
    dp4a.s32.s32    dot2b, 16843009, %xa23, dot2b;   // dot2, i = 1
    // gate: i = 0
    dp4a.s32.s32    t0, %r76, %xa19, 0;
    dp4a.s32.s32    t0, %r77, %xa20, t0;
    mul.lo.s32      t0, t0, %r72;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d80, x, 0f00000000;     // sumf_d
    mul.lo.s32      t1, dot2a, %r74;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d80, x, 0f00000000;     // sumf_m
    // gate: i = 1
    dp4a.s32.s32    t0, %r81, %xa22, 0;
    dp4a.s32.s32    t0, %r82, %xa23, t0;
    mul.lo.s32      t0, t0, %r73;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d81, x, sd;
    mul.lo.s32      t1, dot2b, %r75;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d81, x, sm;
    // dm.x * sumf_d - dm.y * sumf_m
    mul.rn.ftz.f32  x, sm, %f12;
    neg.ftz.f32     x, x;
    fma.rn.ftz.f32  x, sd, %f11, x;
    add.rn.ftz.f32  %fag3, %fag3, x;
    // up: i = 0
    dp4a.s32.s32    t0, %r101, %xa19, 0;
    dp4a.s32.s32    t0, %r102, %xa20, t0;
    mul.lo.s32      t0, t0, %r97;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d80, x, 0f00000000;     // sumf_d
    mul.lo.s32      t1, dot2a, %r99;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d80, x, 0f00000000;     // sumf_m
    // up: i = 1
    dp4a.s32.s32    t0, %r106, %xa22, 0;
    dp4a.s32.s32    t0, %r107, %xa23, t0;
    mul.lo.s32      t0, t0, %r98;
    cvt.rn.f32.s32  x, t0;
    fma.rn.ftz.f32  sd, d81, x, sd;
    mul.lo.s32      t1, dot2b, %r100;
    cvt.rn.f32.s32  x, t1;
    fma.rn.ftz.f32  sm, d81, x, sm;
    // dm.x * sumf_d - dm.y * sumf_m
    mul.rn.ftz.f32  x, sm, %f22;
    neg.ftz.f32     x, x;
    fma.rn.ftz.f32  x, sd, %f21, x;
    add.rn.ftz.f32  %fau3, %fau3, x;
    }

    add.s32         %r30, %r30, %r14;
    setp.lt.s32     %p7, %r30, %r29;
    @%p7 bra        LOOPU4;

REDUCEU4:
    // sum_lanes: offsets L / 2 .. 1 (L is warp-uniform).
    shr.u32         %r111, %r14, 1;
    setp.eq.s32     %p8, %r111, 0;
    @%p8 bra        STOREU4;
RLOOPU4:
    mov.b32         %r112, %fag0;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fag0, %fag0, %f40;
    mov.b32         %r112, %fau0;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fau0, %fau0, %f40;
    mov.b32         %r112, %fag1;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fag1, %fag1, %f40;
    mov.b32         %r112, %fau1;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fau1, %fau1, %f40;
    mov.b32         %r112, %fag2;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fag2, %fag2, %f40;
    mov.b32         %r112, %fau2;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fau2, %fau2, %f40;
    mov.b32         %r112, %fag3;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fag3, %fag3, %f40;
    mov.b32         %r112, %fau3;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fau3, %fau3, %f40;
    shr.u32         %r111, %r111, 1;
    setp.ne.s32     %p8, %r111, 0;
    @%p8 bra        RLOOPU4;
STOREU4:
    setp.ne.s32     %p9, %r16, 0;
    not.pred        %p10, %p3;
    or.pred         %p9, %p9, %p10;
    @%p9 bra        NEXT;
    ld.param.u64    %rd30, [P+64];
    ld.param.u64    %rd31, [P+72];
    ld.param.u64    %rd32, [P+80];
    mul.wide.s32    %rd34, %r23, 4;
    add.s64         %rd30, %rd30, %rd34;
    ld.param.f32    %f27, [P+120];
    setp.gt.ftz.f32 %p11, %f27, 0f00000000;
    neg.ftz.f32     %f28, %f27;
    // user 0: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj0;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut0;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    // The clamp (GLM-5's swiglu_limit), then silu(g) * u.
    mov.f32         %f29, %fag0;
    mov.f32         %f30, %fau0;
    @!%p11 bra      SILUU4_0;
    min.ftz.f32     %f29, %f29, %f27;
    max.ftz.f32     %f30, %f30, %f28;
    min.ftz.f32     %f30, %f30, %f27;
SILUU4_0:
    mul.rn.ftz.f32  %f31, %f29, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f31, %f31;
    add.rn.ftz.f32  %f32, %f31, 0f3F800000;
    div.approx.ftz.f32 %f33, %f29, %f32;
    mul.rn.ftz.f32  %f34, %f30, %f33;
    st.global.f32   [%rd35], %f34;
    // user 1: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj1;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut1;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    // The clamp (GLM-5's swiglu_limit), then silu(g) * u.
    mov.f32         %f29, %fag1;
    mov.f32         %f30, %fau1;
    @!%p11 bra      SILUU4_1;
    min.ftz.f32     %f29, %f29, %f27;
    max.ftz.f32     %f30, %f30, %f28;
    min.ftz.f32     %f30, %f30, %f27;
SILUU4_1:
    mul.rn.ftz.f32  %f31, %f29, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f31, %f31;
    add.rn.ftz.f32  %f32, %f31, 0f3F800000;
    div.approx.ftz.f32 %f33, %f29, %f32;
    mul.rn.ftz.f32  %f34, %f30, %f33;
    st.global.f32   [%rd35], %f34;
    // user 2: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj2;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut2;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    // The clamp (GLM-5's swiglu_limit), then silu(g) * u.
    mov.f32         %f29, %fag2;
    mov.f32         %f30, %fau2;
    @!%p11 bra      SILUU4_2;
    min.ftz.f32     %f29, %f29, %f27;
    max.ftz.f32     %f30, %f30, %f28;
    min.ftz.f32     %f30, %f30, %f27;
SILUU4_2:
    mul.rn.ftz.f32  %f31, %f29, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f31, %f31;
    add.rn.ftz.f32  %f32, %f31, 0f3F800000;
    div.approx.ftz.f32 %f33, %f29, %f32;
    mul.rn.ftz.f32  %f34, %f30, %f33;
    st.global.f32   [%rd35], %f34;
    // user 3: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj3;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut3;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    // The clamp (GLM-5's swiglu_limit), then silu(g) * u.
    mov.f32         %f29, %fag3;
    mov.f32         %f30, %fau3;
    @!%p11 bra      SILUU4_3;
    min.ftz.f32     %f29, %f29, %f27;
    max.ftz.f32     %f30, %f30, %f28;
    min.ftz.f32     %f30, %f30, %f27;
SILUU4_3:
    mul.rn.ftz.f32  %f31, %f29, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f31, %f31;
    add.rn.ftz.f32  %f32, %f31, 0f3F800000;
    div.approx.ftz.f32 %f33, %f29, %f32;
    mul.rn.ftz.f32  %f34, %f30, %f33;
    st.global.f32   [%rd35], %f34;
    bra.uni         NEXT;

NEXT:
    add.s32         %rskip, %rskip, 4;
    setp.lt.s32     %p1, %rskip, %rtot;
    @%p1 bra        SCAN;                   // more users (uniform)
DONE:
    ret;
}

// down Q5_1 (24-byte blocks of 32: half2 dm, 32 high bits, 16 bytes of nibbles). A unit is two
// nibble ints of one block: unit c is block c / 2, iqs 2 * (c % 2).
// One user.
.visible .entry legion_ptx_q51_mv(
    .param .align 8 .b8 P[128]
)
.maxntid 128, 1, 1
{
    .reg .pred  %p<12>;
    .reg .b32   %r<120>;
    .reg .b64   %rd<40>;
    .reg .f32   %f<48>;
    .reg .b32   %rnt, %rnp, %rskip, %rnu, %rtot, %rbase;
    .reg .b32   %rsq, %rsid, %rst, %rsj, %rsm, %rsl, %rslo, %rse, %rsb;
    .reg .b64   %rds1, %rds2;
    .reg .b32   %ruq<4>, %rut<4>, %ruj<4>, %rux<4>;
    .reg .b64   %ruy<4>, %rdb<4>, %rdi<4>;
    .reg .b32   %xa<20>;
    .reg .f32   %fa<4>;

    // The pair q and its expert e.
    mov.u32         %r1, %ctaid.y;
    ld.param.u32    %r2, [P+92];            // n_used
    div.u32         %r3, %r1, %r2;          // t
    rem.u32         %r4, %r1, %r2;          // j
    ld.param.u64    %rd1, [P+48];           // ids
    ld.param.u64    %rd2, [P+56];           // ids_nb1
    cvt.u64.u32     %rd3, %r3;
    mul.lo.s64      %rd4, %rd3, %rd2;
    add.s64         %rd4, %rd1, %rd4;
    mul.wide.u32    %rd5, %r4, 4;
    add.s64         %rd4, %rd4, %rd5;
    ld.global.nc.s32 %r5, [%rd4];           // e
    ld.param.u32    %r6, [P+104];           // n_w
    ld.param.u32    %r7, [P+100];           // vram_below
    setp.lt.s32     %p1, %r5, 0;
    setp.ge.s32     %p2, %r5, %r6;
    or.pred         %p1, %p1, %p2;
    setp.ge.s32     %p2, %r5, %r7;
    or.pred         %p1, %p1, %p2;
    ld.param.u32    %r8, [P+108];           // part
    setp.eq.s32     %p2, %r8, 2;
    or.pred         %p1, %p1, %p2;
    setp.eq.s32     %p2, %r8, 4;
    or.pred         %p1, %p1, %p2;
    @%p1 bra        DONE;                   // uniform over the CTA

    // This lane's row and place in it.
    ld.param.u32    %r9, [P+116];           // lshift
    mov.u32         %r10, %tid.x;
    shr.u32         %r11, %r10, 5;          // warp
    and.b32         %r12, %r10, 31;         // lane
    mov.u32         %r13, 1;
    shl.b32         %r14, %r13, %r9;        // L
    add.s32         %r15, %r14, -1;
    and.b32         %r16, %r12, %r15;       // sub
    mov.u32         %r17, 32;
    shr.u32         %r18, %r17, %r9;        // rows per warp
    shl.b32         %r19, %r18, 2;          // rows per CTA
    mov.u32         %r20, %ctaid.x;
    mul.lo.s32      %r21, %r20, %r19;
    mad.lo.s32      %r21, %r11, %r18, %r21;
    shr.u32         %r22, %r12, %r9;
    add.s32         %r23, %r21, %r22;       // r
    ld.param.u32    %r24, [P+88];           // rows
    setp.lt.s32     %p3, %r23, %r24;        // this lane's row exists
    add.s32         %r25, %r24, -1;
    min.s32         %r26, %r23, %r25;       // a row to address (loads stay in bounds)

    // The expert's row(s).
    ld.param.u64    %rd6, [P+0];
    ld.param.u64    %rd8, [P+16];           // w_nb1
    ld.param.u64    %rd9, [P+24];           // w_nb2
    cvt.s64.s32     %rd10, %r5;
    mul.lo.s64      %rd10, %rd10, %rd9;
    cvt.s64.s32     %rd11, %r26;
    mad.lo.s64      %rd10, %rd11, %rd8, %rd10;
    add.s64         %rd12, %rd6, %rd10;     // (gate) row

    ld.param.u32    %r29, [P+112];          // units
    ld.param.u32    %r27, [P+96];           // n_x
    setp.eq.s32     %p4, %r27, 1;
    ld.param.u64    %rd14, [P+32];          // xq
    ld.param.u64    %rd15, [P+40];          // xq_col
    mov.u32         %ruq0, %r1;
    // One user: q.

U1:
    div.u32         %rut0, %ruq0, %r2;
    rem.u32         %ruj0, %ruq0, %r2;
    selp.b32        %rux0, 0, %ruj0, %p4;
    mad.lo.s32      %rux0, %rut0, %r27, %rux0;
    cvt.u64.u32     %ruy0, %rux0;
    mad.lo.s64      %ruy0, %ruy0, %rd15, %rd14;     // y_0
    mov.f32         %fa0, 0f00000000;
    selp.b32        %r30, %r16, %r29, %p3;
    setp.ge.s32     %p5, %r30, %r29;
    @%p5 bra        REDUCEU1;
LOOPU1:
    shr.u32         %r31, %r30, 1;          // kbx
    and.b32         %r32, %r30, 1;
    shl.b32         %r33, %r32, 1;          // iqs: 0 or 2
    mul.wide.u32    %rd18, %r31, 24;
    add.s64         %rd19, %rd12, %rd18;    // the block
    shl.b32         %r34, %r33, 2;          // 4 * iqs
    cvt.u64.u32     %rd20, %r34;
    add.s64         %rd21, %rd19, %rd20;
    mul.wide.u32    %rd22, %r31, 36;        // activation block kbx
    add.s64         %rd24, %rd22, %rd20;

    ld.global.nc.v2.u32 {%r35, %r36}, [%rd19];       // dm, qh
    ld.global.nc.v2.u32 {%r37, %r38}, [%rd21+8];     // vl[0], vl[1]
    add.s64         %rdb0, %ruy0, %rd22;     // user 0
    add.s64         %rdi0, %ruy0, %rd24;
    ld.global.nc.u32    %xa0, [%rdb0];               // ds
    ld.global.nc.u32    %xa1, [%rdi0+4];             // u[0]: int iqs
    ld.global.nc.u32    %xa2, [%rdi0+20];            // u[1]: iqs + 4
    ld.global.nc.u32    %xa3, [%rdi0+8];             // u[2]: iqs + 1
    ld.global.nc.u32    %xa4, [%rdi0+24];            // u[3]: iqs + 5

    // vh[i] = qh >> (4 * (iqs + i)), arithmetic.
    shl.b32         %r44, %r33, 2;
    shr.s32         %r45, %r36, %r44;       // vh[0]
    add.s32         %r46, %r44, 4;
    shr.s32         %r47, %r36, %r46;       // vh[1]

    // The weights' four ints with their high bits, i = 0
    and.b32         %r48, %r37, 252645135;
    shl.b32         %r49, %r45, 4;
    and.b32         %r49, %r49, 16;
    or.b32          %r48, %r48, %r49;
    shl.b32         %r49, %r45, 11;
    and.b32         %r49, %r49, 4096;
    or.b32          %r48, %r48, %r49;
    shl.b32         %r49, %r45, 18;
    and.b32         %r49, %r49, 1048576;
    or.b32          %r48, %r48, %r49;
    shl.b32         %r49, %r45, 25;
    and.b32         %r49, %r49, 268435456;
    or.b32          %r48, %r48, %r49;
    shr.u32         %r51, %r37, 4;
    and.b32         %r51, %r51, 252645135;
    shr.u32         %r52, %r45, 12;
    and.b32         %r52, %r52, 16;
    or.b32          %r51, %r51, %r52;
    shr.u32         %r52, %r45, 5;
    and.b32         %r52, %r52, 4096;
    or.b32          %r51, %r51, %r52;
    shl.b32         %r52, %r45, 2;
    and.b32         %r52, %r52, 1048576;
    or.b32          %r51, %r51, %r52;
    shl.b32         %r52, %r45, 9;
    and.b32         %r52, %r52, 268435456;
    or.b32          %r51, %r51, %r52;
    // i = 1
    and.b32         %r53, %r38, 252645135;
    shl.b32         %r54, %r47, 4;
    and.b32         %r54, %r54, 16;
    or.b32          %r53, %r53, %r54;
    shl.b32         %r54, %r47, 11;
    and.b32         %r54, %r54, 4096;
    or.b32          %r53, %r53, %r54;
    shl.b32         %r54, %r47, 18;
    and.b32         %r54, %r54, 1048576;
    or.b32          %r53, %r53, %r54;
    shl.b32         %r54, %r47, 25;
    and.b32         %r54, %r54, 268435456;
    or.b32          %r53, %r53, %r54;
    shr.u32         %r55, %r38, 4;
    and.b32         %r55, %r55, 252645135;
    shr.u32         %r56, %r47, 12;
    and.b32         %r56, %r56, 16;
    or.b32          %r55, %r55, %r56;
    shr.u32         %r56, %r47, 5;
    and.b32         %r56, %r56, 4096;
    or.b32          %r55, %r55, %r56;
    shl.b32         %r56, %r47, 2;
    and.b32         %r56, %r56, 1048576;
    or.b32          %r55, %r55, %r56;
    shl.b32         %r56, %r47, 9;
    and.b32         %r56, %r56, 268435456;
    or.b32          %r55, %r55, %r56;

    // ---- user 0: sumi, (d5d8, m5s8) = dm * ds in f16x2, then sumi * d5d8 + m5s8 / 2 ----
    {
    .reg .b32 sumi, dd;
    .reg .f32 d, m, x, h;
    .reg .f16 lo, hi;
    dp4a.s32.s32    sumi, %r48, %xa1, 0;
    dp4a.s32.s32    sumi, %r51, %xa2, sumi;
    dp4a.s32.s32    sumi, %r53, %xa3, sumi;
    dp4a.s32.s32    sumi, %r55, %xa4, sumi;
    mul.rn.f16x2    dd, %r35, %xa0;
    mov.b32         {lo, hi}, dd;
    cvt.f32.f16     d, lo;
    cvt.f32.f16     m, hi;
    cvt.rn.f32.s32  x, sumi;
    div.approx.ftz.f32 h, m, 0f40000000;
    fma.rn.ftz.f32  x, d, x, h;
    add.rn.ftz.f32  %fa0, %fa0, x;
    }

    add.s32         %r30, %r30, %r14;
    setp.lt.s32     %p7, %r30, %r29;
    @%p7 bra        LOOPU1;

REDUCEU1:
    // sum_lanes: offsets L / 2 .. 1 (L is warp-uniform).
    shr.u32         %r111, %r14, 1;
    setp.eq.s32     %p8, %r111, 0;
    @%p8 bra        STOREU1;
RLOOPU1:
    mov.b32         %r112, %fa0;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fa0, %fa0, %f40;
    shr.u32         %r111, %r111, 1;
    setp.ne.s32     %p8, %r111, 0;
    @%p8 bra        RLOOPU1;
STOREU1:
    setp.ne.s32     %p9, %r16, 0;
    not.pred        %p10, %p3;
    or.pred         %p9, %p9, %p10;
    @%p9 bra        NEXT;
    ld.param.u64    %rd30, [P+64];
    ld.param.u64    %rd31, [P+72];
    ld.param.u64    %rd32, [P+80];
    mul.wide.s32    %rd34, %r23, 4;
    add.s64         %rd30, %rd30, %rd34;
    // user 0: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj0;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut0;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    st.global.f32   [%rd35], %fa0;
    bra.uni         NEXT;

NEXT:
DONE:
    ret;
}

// The same with every user of the expert (steps of several tokens): a code path per user count,
// so a CTA's registers are the most users' and the one-token entry above stays lean.
.visible .entry legion_ptx_q51_mv_users(
    .param .align 8 .b8 P[128]
)
.maxntid 128, 1, 1
.minnctapersm 8
{
    .reg .pred  %p<12>;
    .reg .b32   %r<120>;
    .reg .b64   %rd<40>;
    .reg .f32   %f<48>;
    .reg .b32   %rnt, %rnp, %rskip, %rnu, %rtot, %rbase;
    .reg .b32   %rsq, %rsid, %rst, %rsj, %rsm, %rsl, %rslo, %rse, %rsb;
    .reg .b64   %rds1, %rds2;
    .reg .b32   %ruq<4>, %rut<4>, %ruj<4>, %rux<4>;
    .reg .b64   %ruy<4>, %rdb<4>, %rdi<4>;
    .reg .b32   %xa<20>;
    .reg .f32   %fa<4>;

    // The pair q and its expert e.
    mov.u32         %r1, %ctaid.y;
    ld.param.u32    %r2, [P+92];            // n_used
    div.u32         %r3, %r1, %r2;          // t
    rem.u32         %r4, %r1, %r2;          // j
    ld.param.u64    %rd1, [P+48];           // ids
    ld.param.u64    %rd2, [P+56];           // ids_nb1
    cvt.u64.u32     %rd3, %r3;
    mul.lo.s64      %rd4, %rd3, %rd2;
    add.s64         %rd4, %rd1, %rd4;
    mul.wide.u32    %rd5, %r4, 4;
    add.s64         %rd4, %rd4, %rd5;
    ld.global.nc.s32 %r5, [%rd4];           // e
    ld.param.u32    %r6, [P+104];           // n_w
    ld.param.u32    %r7, [P+100];           // vram_below
    setp.lt.s32     %p1, %r5, 0;
    setp.ge.s32     %p2, %r5, %r6;
    or.pred         %p1, %p1, %p2;
    setp.ge.s32     %p2, %r5, %r7;
    or.pred         %p1, %p1, %p2;
    ld.param.u32    %r8, [P+108];           // part
    setp.eq.s32     %p2, %r8, 2;
    or.pred         %p1, %p1, %p2;
    setp.eq.s32     %p2, %r8, 4;
    or.pred         %p1, %p1, %p2;
    @%p1 bra        DONE;                   // uniform over the CTA

    // This lane's row and place in it.
    ld.param.u32    %r9, [P+116];           // lshift
    mov.u32         %r10, %tid.x;
    shr.u32         %r11, %r10, 5;          // warp
    and.b32         %r12, %r10, 31;         // lane
    mov.u32         %r13, 1;
    shl.b32         %r14, %r13, %r9;        // L
    add.s32         %r15, %r14, -1;
    and.b32         %r16, %r12, %r15;       // sub
    mov.u32         %r17, 32;
    shr.u32         %r18, %r17, %r9;        // rows per warp
    shl.b32         %r19, %r18, 2;          // rows per CTA
    mov.u32         %r20, %ctaid.x;
    mul.lo.s32      %r21, %r20, %r19;
    mad.lo.s32      %r21, %r11, %r18, %r21;
    shr.u32         %r22, %r12, %r9;
    add.s32         %r23, %r21, %r22;       // r
    ld.param.u32    %r24, [P+88];           // rows
    setp.lt.s32     %p3, %r23, %r24;        // this lane's row exists
    add.s32         %r25, %r24, -1;
    min.s32         %r26, %r23, %r25;       // a row to address (loads stay in bounds)

    // The expert's row(s).
    ld.param.u64    %rd6, [P+0];
    ld.param.u64    %rd8, [P+16];           // w_nb1
    ld.param.u64    %rd9, [P+24];           // w_nb2
    cvt.s64.s32     %rd10, %r5;
    mul.lo.s64      %rd10, %rd10, %rd9;
    cvt.s64.s32     %rd11, %r26;
    mad.lo.s64      %rd10, %rd11, %rd8, %rd10;
    add.s64         %rd12, %rd6, %rd10;     // (gate) row

    ld.param.u32    %r29, [P+112];          // units
    ld.param.u32    %r27, [P+96];           // n_x
    setp.eq.s32     %p4, %r27, 1;
    ld.param.u64    %rd14, [P+32];          // xq
    ld.param.u64    %rd15, [P+40];          // xq_col
    mov.u32         %ruq0, %r1;

    // The users: the pairs from q on that chose e (none before q: the first pair's CTAs take
    // them all), MAX_USERS per round, `skip` done so far.
    ld.param.u32    %rnt, [P+124];          // n_tok
    mul.lo.s32      %rnp, %r2, %rnt;        // pairs
    mov.u32         %rskip, 0;
SCAN:
    mov.u32         %rnu, 0;
    mov.u32         %rtot, 0;
    mov.u32         %rbase, 0;
SLOOP:
    // Pair base + lane's id, a ballot of those that are e.
    add.s32         %rsq, %rbase, %r12;
    mov.u32         %rsid, -1;
    setp.lt.s32     %p1, %rsq, %rnp;
    @!%p1 bra       SBALLOT;
    div.u32         %rst, %rsq, %r2;
    rem.u32         %rsj, %rsq, %r2;
    cvt.u64.u32     %rds1, %rst;
    mul.lo.s64      %rds1, %rds1, %rd2;
    add.s64         %rds1, %rd1, %rds1;
    mul.wide.u32    %rds2, %rsj, 4;
    add.s64         %rds1, %rds1, %rds2;
    ld.global.nc.s32 %rsid, [%rds1];
SBALLOT:
    setp.eq.s32     %p1, %rsid, %r5;
    vote.sync.ballot.b32 %rsm, %p1, -1;
    // Bits of pairs before q: (1 << clamp(q - base, 0, 32)) - 1 (a shift by 32 gives 0).
    sub.s32         %rsl, %r1, %rbase;
    max.s32         %rsl, %rsl, 0;
    min.s32         %rsl, %rsl, 32;
    shl.b32         %rslo, %r13, %rsl;
    add.s32         %rslo, %rslo, -1;
    and.b32         %rse, %rsm, %rslo;
    setp.ne.s32     %p1, %rse, 0;
    @%p1 bra        DONE;                   // an earlier pair's (uniform)
    not.b32         %rslo, %rslo;
    and.b32         %rsm, %rsm, %rslo;
SBIT:
    setp.eq.s32     %p1, %rsm, 0;
    @%p1 bra        SNEXT;
    neg.s32         %rse, %rsm;
    and.b32         %rse, %rsm, %rse;       // lowest bit
    xor.b32         %rsm, %rsm, %rse;
    bfind.u32       %rsb, %rse;
    add.s32         %rsq, %rbase, %rsb;     // a user
    setp.ge.s32     %p1, %rtot, %rskip;
    setp.lt.s32     %p2, %rnu, 4;
    and.pred        %p1, %p1, %p2;          // in this round
    setp.eq.s32     %p2, %rnu, 0;
    and.pred        %p2, %p2, %p1;
    @%p2 mov.u32    %ruq0, %rsq;
    setp.eq.s32     %p2, %rnu, 1;
    and.pred        %p2, %p2, %p1;
    @%p2 mov.u32    %ruq1, %rsq;
    setp.eq.s32     %p2, %rnu, 2;
    and.pred        %p2, %p2, %p1;
    @%p2 mov.u32    %ruq2, %rsq;
    setp.eq.s32     %p2, %rnu, 3;
    and.pred        %p2, %p2, %p1;
    @%p2 mov.u32    %ruq3, %rsq;
    @%p1 add.s32    %rnu, %rnu, 1;
    add.s32         %rtot, %rtot, 1;
    bra.uni         SBIT;
SNEXT:
    add.s32         %rbase, %rbase, 32;
    setp.lt.s32     %p1, %rbase, %rnp;
    @%p1 bra        SLOOP;
DISPATCH:
    setp.eq.s32     %p1, %rnu, 0;
    @%p1 bra        DONE;
    setp.eq.s32     %p1, %rnu, 1;
    @%p1 bra        U1;
    setp.eq.s32     %p1, %rnu, 2;
    @%p1 bra        U2;
    setp.eq.s32     %p1, %rnu, 3;
    @%p1 bra        U3;
    bra.uni         U4;

U1:
    div.u32         %rut0, %ruq0, %r2;
    rem.u32         %ruj0, %ruq0, %r2;
    selp.b32        %rux0, 0, %ruj0, %p4;
    mad.lo.s32      %rux0, %rut0, %r27, %rux0;
    cvt.u64.u32     %ruy0, %rux0;
    mad.lo.s64      %ruy0, %ruy0, %rd15, %rd14;     // y_0
    mov.f32         %fa0, 0f00000000;
    selp.b32        %r30, %r16, %r29, %p3;
    setp.ge.s32     %p5, %r30, %r29;
    @%p5 bra        REDUCEU1;
LOOPU1:
    shr.u32         %r31, %r30, 1;          // kbx
    and.b32         %r32, %r30, 1;
    shl.b32         %r33, %r32, 1;          // iqs: 0 or 2
    mul.wide.u32    %rd18, %r31, 24;
    add.s64         %rd19, %rd12, %rd18;    // the block
    shl.b32         %r34, %r33, 2;          // 4 * iqs
    cvt.u64.u32     %rd20, %r34;
    add.s64         %rd21, %rd19, %rd20;
    mul.wide.u32    %rd22, %r31, 36;        // activation block kbx
    add.s64         %rd24, %rd22, %rd20;

    ld.global.nc.v2.u32 {%r35, %r36}, [%rd19];       // dm, qh
    ld.global.nc.v2.u32 {%r37, %r38}, [%rd21+8];     // vl[0], vl[1]
    add.s64         %rdb0, %ruy0, %rd22;     // user 0
    add.s64         %rdi0, %ruy0, %rd24;
    ld.global.nc.u32    %xa0, [%rdb0];               // ds
    ld.global.nc.u32    %xa1, [%rdi0+4];             // u[0]: int iqs
    ld.global.nc.u32    %xa2, [%rdi0+20];            // u[1]: iqs + 4
    ld.global.nc.u32    %xa3, [%rdi0+8];             // u[2]: iqs + 1
    ld.global.nc.u32    %xa4, [%rdi0+24];            // u[3]: iqs + 5

    // vh[i] = qh >> (4 * (iqs + i)), arithmetic.
    shl.b32         %r44, %r33, 2;
    shr.s32         %r45, %r36, %r44;       // vh[0]
    add.s32         %r46, %r44, 4;
    shr.s32         %r47, %r36, %r46;       // vh[1]

    // The weights' four ints with their high bits, i = 0
    and.b32         %r48, %r37, 252645135;
    shl.b32         %r49, %r45, 4;
    and.b32         %r49, %r49, 16;
    or.b32          %r48, %r48, %r49;
    shl.b32         %r49, %r45, 11;
    and.b32         %r49, %r49, 4096;
    or.b32          %r48, %r48, %r49;
    shl.b32         %r49, %r45, 18;
    and.b32         %r49, %r49, 1048576;
    or.b32          %r48, %r48, %r49;
    shl.b32         %r49, %r45, 25;
    and.b32         %r49, %r49, 268435456;
    or.b32          %r48, %r48, %r49;
    shr.u32         %r51, %r37, 4;
    and.b32         %r51, %r51, 252645135;
    shr.u32         %r52, %r45, 12;
    and.b32         %r52, %r52, 16;
    or.b32          %r51, %r51, %r52;
    shr.u32         %r52, %r45, 5;
    and.b32         %r52, %r52, 4096;
    or.b32          %r51, %r51, %r52;
    shl.b32         %r52, %r45, 2;
    and.b32         %r52, %r52, 1048576;
    or.b32          %r51, %r51, %r52;
    shl.b32         %r52, %r45, 9;
    and.b32         %r52, %r52, 268435456;
    or.b32          %r51, %r51, %r52;
    // i = 1
    and.b32         %r53, %r38, 252645135;
    shl.b32         %r54, %r47, 4;
    and.b32         %r54, %r54, 16;
    or.b32          %r53, %r53, %r54;
    shl.b32         %r54, %r47, 11;
    and.b32         %r54, %r54, 4096;
    or.b32          %r53, %r53, %r54;
    shl.b32         %r54, %r47, 18;
    and.b32         %r54, %r54, 1048576;
    or.b32          %r53, %r53, %r54;
    shl.b32         %r54, %r47, 25;
    and.b32         %r54, %r54, 268435456;
    or.b32          %r53, %r53, %r54;
    shr.u32         %r55, %r38, 4;
    and.b32         %r55, %r55, 252645135;
    shr.u32         %r56, %r47, 12;
    and.b32         %r56, %r56, 16;
    or.b32          %r55, %r55, %r56;
    shr.u32         %r56, %r47, 5;
    and.b32         %r56, %r56, 4096;
    or.b32          %r55, %r55, %r56;
    shl.b32         %r56, %r47, 2;
    and.b32         %r56, %r56, 1048576;
    or.b32          %r55, %r55, %r56;
    shl.b32         %r56, %r47, 9;
    and.b32         %r56, %r56, 268435456;
    or.b32          %r55, %r55, %r56;

    // ---- user 0: sumi, (d5d8, m5s8) = dm * ds in f16x2, then sumi * d5d8 + m5s8 / 2 ----
    {
    .reg .b32 sumi, dd;
    .reg .f32 d, m, x, h;
    .reg .f16 lo, hi;
    dp4a.s32.s32    sumi, %r48, %xa1, 0;
    dp4a.s32.s32    sumi, %r51, %xa2, sumi;
    dp4a.s32.s32    sumi, %r53, %xa3, sumi;
    dp4a.s32.s32    sumi, %r55, %xa4, sumi;
    mul.rn.f16x2    dd, %r35, %xa0;
    mov.b32         {lo, hi}, dd;
    cvt.f32.f16     d, lo;
    cvt.f32.f16     m, hi;
    cvt.rn.f32.s32  x, sumi;
    div.approx.ftz.f32 h, m, 0f40000000;
    fma.rn.ftz.f32  x, d, x, h;
    add.rn.ftz.f32  %fa0, %fa0, x;
    }

    add.s32         %r30, %r30, %r14;
    setp.lt.s32     %p7, %r30, %r29;
    @%p7 bra        LOOPU1;

REDUCEU1:
    // sum_lanes: offsets L / 2 .. 1 (L is warp-uniform).
    shr.u32         %r111, %r14, 1;
    setp.eq.s32     %p8, %r111, 0;
    @%p8 bra        STOREU1;
RLOOPU1:
    mov.b32         %r112, %fa0;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fa0, %fa0, %f40;
    shr.u32         %r111, %r111, 1;
    setp.ne.s32     %p8, %r111, 0;
    @%p8 bra        RLOOPU1;
STOREU1:
    setp.ne.s32     %p9, %r16, 0;
    not.pred        %p10, %p3;
    or.pred         %p9, %p9, %p10;
    @%p9 bra        NEXT;
    ld.param.u64    %rd30, [P+64];
    ld.param.u64    %rd31, [P+72];
    ld.param.u64    %rd32, [P+80];
    mul.wide.s32    %rd34, %r23, 4;
    add.s64         %rd30, %rd30, %rd34;
    // user 0: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj0;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut0;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    st.global.f32   [%rd35], %fa0;
    bra.uni         NEXT;

U2:
    div.u32         %rut0, %ruq0, %r2;
    rem.u32         %ruj0, %ruq0, %r2;
    selp.b32        %rux0, 0, %ruj0, %p4;
    mad.lo.s32      %rux0, %rut0, %r27, %rux0;
    cvt.u64.u32     %ruy0, %rux0;
    mad.lo.s64      %ruy0, %ruy0, %rd15, %rd14;     // y_0
    div.u32         %rut1, %ruq1, %r2;
    rem.u32         %ruj1, %ruq1, %r2;
    selp.b32        %rux1, 0, %ruj1, %p4;
    mad.lo.s32      %rux1, %rut1, %r27, %rux1;
    cvt.u64.u32     %ruy1, %rux1;
    mad.lo.s64      %ruy1, %ruy1, %rd15, %rd14;     // y_1
    mov.f32         %fa0, 0f00000000;
    mov.f32         %fa1, 0f00000000;
    selp.b32        %r30, %r16, %r29, %p3;
    setp.ge.s32     %p5, %r30, %r29;
    @%p5 bra        REDUCEU2;
LOOPU2:
    shr.u32         %r31, %r30, 1;          // kbx
    and.b32         %r32, %r30, 1;
    shl.b32         %r33, %r32, 1;          // iqs: 0 or 2
    mul.wide.u32    %rd18, %r31, 24;
    add.s64         %rd19, %rd12, %rd18;    // the block
    shl.b32         %r34, %r33, 2;          // 4 * iqs
    cvt.u64.u32     %rd20, %r34;
    add.s64         %rd21, %rd19, %rd20;
    mul.wide.u32    %rd22, %r31, 36;        // activation block kbx
    add.s64         %rd24, %rd22, %rd20;

    ld.global.nc.v2.u32 {%r35, %r36}, [%rd19];       // dm, qh
    ld.global.nc.v2.u32 {%r37, %r38}, [%rd21+8];     // vl[0], vl[1]
    add.s64         %rdb0, %ruy0, %rd22;     // user 0
    add.s64         %rdi0, %ruy0, %rd24;
    ld.global.nc.u32    %xa0, [%rdb0];               // ds
    ld.global.nc.u32    %xa1, [%rdi0+4];             // u[0]: int iqs
    ld.global.nc.u32    %xa2, [%rdi0+20];            // u[1]: iqs + 4
    ld.global.nc.u32    %xa3, [%rdi0+8];             // u[2]: iqs + 1
    ld.global.nc.u32    %xa4, [%rdi0+24];            // u[3]: iqs + 5
    add.s64         %rdb1, %ruy1, %rd22;     // user 1
    add.s64         %rdi1, %ruy1, %rd24;
    ld.global.nc.u32    %xa5, [%rdb1];               // ds
    ld.global.nc.u32    %xa6, [%rdi1+4];             // u[0]: int iqs
    ld.global.nc.u32    %xa7, [%rdi1+20];            // u[1]: iqs + 4
    ld.global.nc.u32    %xa8, [%rdi1+8];             // u[2]: iqs + 1
    ld.global.nc.u32    %xa9, [%rdi1+24];            // u[3]: iqs + 5

    // vh[i] = qh >> (4 * (iqs + i)), arithmetic.
    shl.b32         %r44, %r33, 2;
    shr.s32         %r45, %r36, %r44;       // vh[0]
    add.s32         %r46, %r44, 4;
