    mov.f32         %fa2, 0f00000000;
    mov.f32         %fa3, 0f00000000;
    selp.b32        %r30, %r16, %r29, %p3;
    setp.ge.s32     %p5, %r30, %r29;
    @%p5 bra        REDUCEU4;
LOOPU4:
    shr.u32         %r31, %r30, 1;          // kbx
    and.b32         %r32, %r30, 1;
    shl.b32         %r33, %r32, 1;          // iqs: 0 or 2
    mul.wide.u32    %rd18, %r31, 24;
    add.s64         %rd19, %rd12, %rd18;    // the block
    shl.b32         %r34, %r33, 2;          // 4 * iqs
    cvt.u64.u32     %rd20, %r34;
    add.s64         %rd21, %rd19, %rd20;
    mul.wide.u32    %rd22, %r31, 36;        // activation block kbx
    add.s64         %rd24, %rd22, %rd20;

    ld.global.nc.v2.u32 {%r35, %r36}, [%rd19];       // dm, qh
    ld.global.nc.v2.u32 {%r37, %r38}, [%rd21+8];     // vl[0], vl[1]
    add.s64         %rdb0, %ruy0, %rd22;     // user 0
    add.s64         %rdi0, %ruy0, %rd24;
    ld.global.nc.u32    %xa0, [%rdb0];               // ds
    ld.global.nc.u32    %xa1, [%rdi0+4];             // u[0]: int iqs
    ld.global.nc.u32    %xa2, [%rdi0+20];            // u[1]: iqs + 4
    ld.global.nc.u32    %xa3, [%rdi0+8];             // u[2]: iqs + 1
    ld.global.nc.u32    %xa4, [%rdi0+24];            // u[3]: iqs + 5
    add.s64         %rdb1, %ruy1, %rd22;     // user 1
    add.s64         %rdi1, %ruy1, %rd24;
    ld.global.nc.u32    %xa5, [%rdb1];               // ds
    ld.global.nc.u32    %xa6, [%rdi1+4];             // u[0]: int iqs
    ld.global.nc.u32    %xa7, [%rdi1+20];            // u[1]: iqs + 4
    ld.global.nc.u32    %xa8, [%rdi1+8];             // u[2]: iqs + 1
    ld.global.nc.u32    %xa9, [%rdi1+24];            // u[3]: iqs + 5
    add.s64         %rdb2, %ruy2, %rd22;     // user 2
    add.s64         %rdi2, %ruy2, %rd24;
    ld.global.nc.u32    %xa10, [%rdb2];               // ds
    ld.global.nc.u32    %xa11, [%rdi2+4];             // u[0]: int iqs
    ld.global.nc.u32    %xa12, [%rdi2+20];            // u[1]: iqs + 4
    ld.global.nc.u32    %xa13, [%rdi2+8];             // u[2]: iqs + 1
    ld.global.nc.u32    %xa14, [%rdi2+24];            // u[3]: iqs + 5
    add.s64         %rdb3, %ruy3, %rd22;     // user 3
    add.s64         %rdi3, %ruy3, %rd24;
    ld.global.nc.u32    %xa15, [%rdb3];               // ds
    ld.global.nc.u32    %xa16, [%rdi3+4];             // u[0]: int iqs
    ld.global.nc.u32    %xa17, [%rdi3+20];            // u[1]: iqs + 4
    ld.global.nc.u32    %xa18, [%rdi3+8];             // u[2]: iqs + 1
    ld.global.nc.u32    %xa19, [%rdi3+24];            // u[3]: iqs + 5

    // vh[i] = qh >> (4 * (iqs + i)), arithmetic.
    shl.b32         %r44, %r33, 2;
    shr.s32         %r45, %r36, %r44;       // vh[0]
    add.s32         %r46, %r44, 4;
    shr.s32         %r47, %r36, %r46;       // vh[1]

    // The weights' four ints with their high bits, i = 0
    and.b32         %r48, %r37, 252645135;
    shl.b32         %r49, %r45, 4;
    and.b32         %r49, %r49, 16;
    or.b32          %r48, %r48, %r49;
    shl.b32         %r49, %r45, 11;
    and.b32         %r49, %r49, 4096;
    or.b32          %r48, %r48, %r49;
    shl.b32         %r49, %r45, 18;
    and.b32         %r49, %r49, 1048576;
    or.b32          %r48, %r48, %r49;
    shl.b32         %r49, %r45, 25;
    and.b32         %r49, %r49, 268435456;
    or.b32          %r48, %r48, %r49;
    shr.u32         %r51, %r37, 4;
    and.b32         %r51, %r51, 252645135;
    shr.u32         %r52, %r45, 12;
    and.b32         %r52, %r52, 16;
    or.b32          %r51, %r51, %r52;
    shr.u32         %r52, %r45, 5;
    and.b32         %r52, %r52, 4096;
    or.b32          %r51, %r51, %r52;
    shl.b32         %r52, %r45, 2;
    and.b32         %r52, %r52, 1048576;
    or.b32          %r51, %r51, %r52;
    shl.b32         %r52, %r45, 9;
    and.b32         %r52, %r52, 268435456;
    or.b32          %r51, %r51, %r52;
    // i = 1
    and.b32         %r53, %r38, 252645135;
    shl.b32         %r54, %r47, 4;
    and.b32         %r54, %r54, 16;
    or.b32          %r53, %r53, %r54;
    shl.b32         %r54, %r47, 11;
    and.b32         %r54, %r54, 4096;
    or.b32          %r53, %r53, %r54;
    shl.b32         %r54, %r47, 18;
    and.b32         %r54, %r54, 1048576;
    or.b32          %r53, %r53, %r54;
    shl.b32         %r54, %r47, 25;
    and.b32         %r54, %r54, 268435456;
    or.b32          %r53, %r53, %r54;
    shr.u32         %r55, %r38, 4;
    and.b32         %r55, %r55, 252645135;
    shr.u32         %r56, %r47, 12;
    and.b32         %r56, %r56, 16;
    or.b32          %r55, %r55, %r56;
    shr.u32         %r56, %r47, 5;
    and.b32         %r56, %r56, 4096;
    or.b32          %r55, %r55, %r56;
    shl.b32         %r56, %r47, 2;
    and.b32         %r56, %r56, 1048576;
    or.b32          %r55, %r55, %r56;
    shl.b32         %r56, %r47, 9;
    and.b32         %r56, %r56, 268435456;
    or.b32          %r55, %r55, %r56;

    // ---- user 0: sumi, (d5d8, m5s8) = dm * ds in f16x2, then sumi * d5d8 + m5s8 / 2 ----
    {
    .reg .b32 sumi, dd;
    .reg .f32 d, m, x, h;
    .reg .f16 lo, hi;
    dp4a.s32.s32    sumi, %r48, %xa1, 0;
    dp4a.s32.s32    sumi, %r51, %xa2, sumi;
    dp4a.s32.s32    sumi, %r53, %xa3, sumi;
    dp4a.s32.s32    sumi, %r55, %xa4, sumi;
    mul.rn.f16x2    dd, %r35, %xa0;
    mov.b32         {lo, hi}, dd;
    cvt.f32.f16     d, lo;
    cvt.f32.f16     m, hi;
    cvt.rn.f32.s32  x, sumi;
    div.approx.ftz.f32 h, m, 0f40000000;
    fma.rn.ftz.f32  x, d, x, h;
    add.rn.ftz.f32  %fa0, %fa0, x;
    }

    // ---- user 1: sumi, (d5d8, m5s8) = dm * ds in f16x2, then sumi * d5d8 + m5s8 / 2 ----
    {
    .reg .b32 sumi, dd;
    .reg .f32 d, m, x, h;
    .reg .f16 lo, hi;
    dp4a.s32.s32    sumi, %r48, %xa6, 0;
    dp4a.s32.s32    sumi, %r51, %xa7, sumi;
    dp4a.s32.s32    sumi, %r53, %xa8, sumi;
    dp4a.s32.s32    sumi, %r55, %xa9, sumi;
    mul.rn.f16x2    dd, %r35, %xa5;
    mov.b32         {lo, hi}, dd;
    cvt.f32.f16     d, lo;
    cvt.f32.f16     m, hi;
    cvt.rn.f32.s32  x, sumi;
    div.approx.ftz.f32 h, m, 0f40000000;
    fma.rn.ftz.f32  x, d, x, h;
    add.rn.ftz.f32  %fa1, %fa1, x;
    }

    // ---- user 2: sumi, (d5d8, m5s8) = dm * ds in f16x2, then sumi * d5d8 + m5s8 / 2 ----
    {
    .reg .b32 sumi, dd;
    .reg .f32 d, m, x, h;
    .reg .f16 lo, hi;
    dp4a.s32.s32    sumi, %r48, %xa11, 0;
    dp4a.s32.s32    sumi, %r51, %xa12, sumi;
    dp4a.s32.s32    sumi, %r53, %xa13, sumi;
    dp4a.s32.s32    sumi, %r55, %xa14, sumi;
    mul.rn.f16x2    dd, %r35, %xa10;
    mov.b32         {lo, hi}, dd;
    cvt.f32.f16     d, lo;
    cvt.f32.f16     m, hi;
    cvt.rn.f32.s32  x, sumi;
    div.approx.ftz.f32 h, m, 0f40000000;
    fma.rn.ftz.f32  x, d, x, h;
    add.rn.ftz.f32  %fa2, %fa2, x;
    }

    // ---- user 3: sumi, (d5d8, m5s8) = dm * ds in f16x2, then sumi * d5d8 + m5s8 / 2 ----
    {
    .reg .b32 sumi, dd;
    .reg .f32 d, m, x, h;
    .reg .f16 lo, hi;
    dp4a.s32.s32    sumi, %r48, %xa16, 0;
    dp4a.s32.s32    sumi, %r51, %xa17, sumi;
    dp4a.s32.s32    sumi, %r53, %xa18, sumi;
    dp4a.s32.s32    sumi, %r55, %xa19, sumi;
    mul.rn.f16x2    dd, %r35, %xa15;
    mov.b32         {lo, hi}, dd;
    cvt.f32.f16     d, lo;
    cvt.f32.f16     m, hi;
    cvt.rn.f32.s32  x, sumi;
    div.approx.ftz.f32 h, m, 0f40000000;
    fma.rn.ftz.f32  x, d, x, h;
    add.rn.ftz.f32  %fa3, %fa3, x;
    }

    add.s32         %r30, %r30, %r14;
    setp.lt.s32     %p7, %r30, %r29;
    @%p7 bra        LOOPU4;

REDUCEU4:
    // sum_lanes: offsets L / 2 .. 1 (L is warp-uniform).
    shr.u32         %r111, %r14, 1;
    setp.eq.s32     %p8, %r111, 0;
    @%p8 bra        STOREU4;
RLOOPU4:
    mov.b32         %r112, %fa0;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fa0, %fa0, %f40;
    mov.b32         %r112, %fa1;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fa1, %fa1, %f40;
    mov.b32         %r112, %fa2;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fa2, %fa2, %f40;
    mov.b32         %r112, %fa3;
    shfl.sync.bfly.b32 %r113, %r112, %r111, 31, -1;
    mov.b32         %f40, %r113;
    add.rn.ftz.f32  %fa3, %fa3, %f40;
    shr.u32         %r111, %r111, 1;
    setp.ne.s32     %p8, %r111, 0;
    @%p8 bra        RLOOPU4;
STOREU4:
    setp.ne.s32     %p9, %r16, 0;
    not.pred        %p10, %p3;
    or.pred         %p9, %p9, %p10;
    @%p9 bra        NEXT;
    ld.param.u64    %rd30, [P+64];
    ld.param.u64    %rd31, [P+72];
    ld.param.u64    %rd32, [P+80];
    mul.wide.s32    %rd34, %r23, 4;
    add.s64         %rd30, %rd30, %rd34;
    // user 0: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj0;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut0;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    st.global.f32   [%rd35], %fa0;
    // user 1: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj1;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut1;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    st.global.f32   [%rd35], %fa1;
    // user 2: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj2;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut2;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    st.global.f32   [%rd35], %fa2;
    // user 3: dst + t * dst_nb2 + j * dst_nb1 + r * 4
    cvt.u64.u32     %rd33, %ruj3;
    mad.lo.s64      %rd35, %rd33, %rd31, %rd30;
    cvt.u64.u32     %rd33, %rut3;
    mad.lo.s64      %rd35, %rd33, %rd32, %rd35;
    st.global.f32   [%rd35], %fa3;
    bra.uni         NEXT;

NEXT:
    add.s32         %rskip, %rskip, 4;
    setp.lt.s32     %p1, %rskip, %rtot;
    @%p1 bra        SCAN;                   // more users (uniform)
DONE:
    ret;
}
